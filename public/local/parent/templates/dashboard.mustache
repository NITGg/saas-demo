{{!
    @template local_parent/dashboard

    The parent dashboard (bassthalk.com/parent_dashboard): hero, the two-phone
    form, then — once the phones match — the course list and, for the chosen
    course, its lectures with the student's videos, homework and exams.
    Styles: theme/nit/scss/components/_bthparent.scss (every colour from g18).

    Context variables required for this template:
    * action, sesskey, childphone, parentphone, error - the form
    * verified - the phones matched; show the results instead of the form
    * heroimg, decoimg, arrowimg - image URLs
    * hascourses, courses - [{index, id, name, hassections, sections: [{name, date, empty,
      columns: [{hasitems, none, items: [{label, name, done, pending, absent, percent,
      donetext, doneafter, pendingtext, absenttext}]}]}]}]

    Example context (json):
    {
        "action": "#", "sesskey": "x", "childphone": "", "parentphone": "", "error": "",
        "verified": true, "heroimg": "", "decoimg": "", "arrowimg": "", "hascourses": true,
        "courses": [{"index": 0, "id": 2, "name": "Arabic", "hassections": true, "sections": [
            {"name": "Lecture 1", "date": "2026-10-01 10:00:00", "empty": false, "columns": [
                {"hasitems": true, "none": "", "items": [{"label": "Video 1", "name": "Intro", "done": true,
                 "percent": "70", "donetext": "Watched", "doneafter": "of the video"}]},
                {"hasitems": false, "none": "No homework yet", "items": []},
                {"hasitems": false, "none": "No exams yet", "items": []}]}]}]
    }
}}
<div class="bthpd nit-brand-18" id="bthpd">
    <section class="bthpd__hero">
        <div class="bthpd__hero-in">
            <div class="bthpd__card">
                <span class="bthpd__dot bthpd__dot--l" aria-hidden="true"></span>
                <span class="bthpd__dot bthpd__dot--r" aria-hidden="true"></span>
                <h1 class="bthpd__title">{{#str}}title_a, local_parent{{/str}} <span class="bthpd__fancy bthpd__title-hl">{{#str}}title_b, local_parent{{/str}}</span></h1>
                <img class="bthpd__deco" src="{{decoimg}}" alt="" aria-hidden="true">
                <p class="bthpd__intro">{{#str}}intro, local_parent{{/str}}</p>
            </div>
            <div class="bthpd__art"><img src="{{heroimg}}" alt=""></div>
        </div>
    </section>

    {{^verified}}
    <form class="bthpd__form" method="post" action="{{action}}" autocomplete="off">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <div class="bthpd__box">
            <div class="bthpd__group{{#error}} is-error{{/error}}">
                <input type="text" id="bthpd-child" name="childphone" value="{{childphone}}" inputmode="tel" required>
                <span class="bthpd__bg" aria-hidden="true"></span>
                <span class="bthpd__bar" aria-hidden="true"></span>
                <label for="bthpd-child">{{#str}}childphone, local_parent{{/str}}</label>
            </div>
            <div class="bthpd__group{{#error}} is-error{{/error}}">
                <input type="text" id="bthpd-parent" name="parentphone" value="{{parentphone}}" inputmode="tel" required>
                <span class="bthpd__bg" aria-hidden="true"></span>
                <span class="bthpd__bar" aria-hidden="true"></span>
                <label for="bthpd-parent">{{#str}}yourphone, local_parent{{/str}}</label>
            </div>
            {{#error}}<p class="bthpd__error" role="alert">{{error}}</p>{{/error}}
            <button type="submit" class="bthpd__start">{{#str}}start, local_parent{{/str}}</button>
        </div>
    </form>
    {{/verified}}

    {{#verified}}
    <div class="bthpd__results">
        {{#hascourses}}
        <div class="bthpd__navcol">
            <nav class="bthpd__nav" aria-label="{{#str}}courselist, local_parent{{/str}}">
                <div class="bthpd__navtop">
                    <button type="button" class="bthpd__hand" aria-expanded="true" aria-label="{{#str}}togglelist, local_parent{{/str}}">
                        <svg viewBox="0 0 512 512" aria-hidden="true"><path d="m362 0h-212c-82.84 0-150 67.16-150 150v212c0 82.84 67.16 150 150 150h212c82.84 0 150-67.16 150-150v-212c0-82.84-67.16-150-150-150zm-221.23 155.67h24.92l-6.3-6.3c-2.27-2.27-2.5-5.99-.3-8.33 2.28-2.42 6.08-2.46 8.41-.13l16.47 16.47c2.29 2.29 2.29 6 0 8.29l-16.47 16.47c-1.14 1.14-2.64 1.72-4.14 1.72s-2.91-.54-4.04-1.61c-2.39-2.28-2.26-6.23.07-8.57l6.29-6.29h-24.92c-3.24 0-5.86-2.62-5.86-5.86s2.62-5.86 5.86-5.86zm-58.59 0h24.92l-6.3-6.3c-2.27-2.27-2.5-5.99-.3-8.33 2.28-2.42 6.08-2.46 8.41-.13l16.47 16.47c2.29 2.29 2.29 6 0 8.29l-16.47 16.47c-1.14 1.14-2.64 1.72-4.14 1.72s-2.91-.54-4.04-1.61c-2.39-2.28-2.26-6.23.07-8.57l6.29-6.29h-24.92c-3.24 0-5.86-2.62-5.86-5.86s2.62-5.86 5.86-5.86zm274.55 185.8c0 3.34-2.71 6.06-6.06 6.06-5.77 0-11.48 1.06-16.86 3.14l-45.52 17.55c-5.38 2.07-11.1 3.14-16.86 3.14h-48.62c-11.87 0-21.48-9.62-21.48-21.48s9.62-21.48 21.48-21.48h-23.44c-11.87 0-21.48-9.62-21.48-21.48s9.62-21.48 21.48-21.48h-21.09c-11.87 0-21.48-9.62-21.48-21.48s9.62-21.48 21.48-21.48h-80.48c-11.87 0-21.48-9.62-21.48-21.48 0-11.87 9.62-21.48 21.48-21.48h154.5l-23.99-23.99c-8.39-8.39-8.39-21.99 0-30.38 8.39-8.39 21.99-8.39 30.38 0l69.95 61.78c6.52 5.76 14.48 9.55 22.95 11.03 2.94.51 5.12 3 5.12 5.98v117.58zm78.97 8.28c0 12.94-10.49 23.44-23.44 23.44h-23.44c-12.94 0-23.44-10.49-23.44-23.44v-132.81c0-12.94 10.49-23.44 23.44-23.44h23.44c12.94 0 23.44 10.49 23.44 23.44z"/></svg>
                    </button>
                </div>
                {{#courses}}
                <button type="button" class="bthpd__course" data-course="{{id}}" aria-pressed="false">
                    <span class="bthpd__course-num"> - {{index}} - </span>
                    <span class="bthpd__course-name">{{name}}</span>
                </button>
                {{/courses}}
            </nav>
        </div>
        {{/hascourses}}

        <div class="bthpd__main">
            {{^hascourses}}<h2 class="bthpd__prompt">{{#str}}nocourses, local_parent{{/str}}</h2>{{/hascourses}}
            {{#hascourses}}
            <h2 class="bthpd__prompt" data-bthpd-prompt>{{#str}}choosecourse, local_parent{{/str}}</h2>
            {{#courses}}
            <div class="bthpd__stats" data-bthpd-stats="{{id}}" hidden>
                <div class="bthpd__stats-title"><span>{{#str}}stats_a, local_parent{{/str}}<span class="bthpd__fancy bthpd__stats-hl"> {{#str}}stats_b, local_parent{{/str}}</span></span></div>
                <div class="bthpd__head">
                    <div class="bthpd__cname">
                        <h3>{{name}}</h3>
                        <svg class="bthpd__cblob" viewBox="0 0 383 264" aria-hidden="true"><path d="M382.243 125.002C381.056 184.171 347.214 242.172 297.957 214.927C271.675 200.39 260.435 172.329 233.19 187.585C179.613 217.587 177.627 284.161 130.061 257.183C110.479 246.077 119.385 228.486 119.861 215.258C120.453 198.783 111.162 189.729 94.598 191C73.585 192.611 56.4509 205.252 25.0939 203.486C-4.20005 201.835 -5.84903 164.954 13.322 144.61C24.966 132.253 43.5339 125.64 41.6779 94.5922C40.6009 76.5752 30.9889 47.3362 66.3289 34.2952C108.592 18.7002 140.868 42.6732 169.454 55.3152C198.156 68.0082 230.078 55.4342 242.551 26.7102C244.358 22.5492 245.646 18.1362 247.721 14.1222C254.707 0.607152 268.995 -3.69384 282.514 3.41216C300.654 12.9472 291.253 28.6992 287.264 43.6362C281.433 65.4692 291.847 77.2142 314.082 73.7282C325.965 71.8662 383.784 48.1552 382.243 125.002Z"/></svg>
                    </div>
                    <div class="bthpd__toggle-wrap">
                        {{#hassections}}
                        <button type="button" class="bthpd__toggle" aria-expanded="false">
                            <span class="bthpd__toggle-show">{{#str}}showcontent, local_parent{{/str}}</span>
                            <span class="bthpd__toggle-hide">{{#str}}hidecontent, local_parent{{/str}}</span>
                            <svg class="bthpd__toggle-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 19h18a1.002 1.002 0 0 0 .823-1.569l-9-13c-.373-.539-1.271-.539-1.645 0l-9 13A.999.999 0 0 0 3 19"/></svg>
                        </button>
                        {{/hassections}}
                        {{^hassections}}<div class="bthpd__nocontent">{{#str}}nocontent, local_parent{{/str}}</div>{{/hassections}}
                    </div>
                </div>
                {{#hassections}}
                <div class="bthpd__weeks" hidden>
                    {{#sections}}
                    <div class="bthpd__week{{#empty}} is-empty{{/empty}}">
                        <div class="bthpd__week-head"{{^empty}} role="button" tabindex="0" aria-expanded="false"{{/empty}}>
                            <h4 class="bthpd__week-title">
                                <span class="bthpd__week-name">
                                    <svg class="bthpd__wblob" viewBox="0 0 383 264" preserveAspectRatio="none" aria-hidden="true"><path d="M382.243 125.002C381.056 184.171 347.214 242.172 297.957 214.927C271.675 200.39 260.435 172.329 233.19 187.585C179.613 217.587 177.627 284.161 130.061 257.183C110.479 246.077 119.385 228.486 119.861 215.258C120.453 198.783 111.162 189.729 94.598 191C73.585 192.611 56.4509 205.252 25.0939 203.486C-4.20005 201.835 -5.84903 164.954 13.322 144.61C24.966 132.253 43.5339 125.64 41.6779 94.5922C40.6009 76.5752 30.9889 47.3362 66.3289 34.2952C108.592 18.7002 140.868 42.6732 169.454 55.3152C198.156 68.0082 230.078 55.4342 242.551 26.7102C244.358 22.5492 245.646 18.1362 247.721 14.1222C254.707 0.607152 268.995 -3.69384 282.514 3.41216C300.654 12.9472 291.253 28.6992 287.264 43.6362C281.433 65.4692 291.847 77.2142 314.082 73.7282C325.965 71.8662 383.784 48.1552 382.243 125.002Z"/></svg>
                                    <span class="bthpd__week-label">{{name}}</span>
                                </span>
                                {{#date}}
                                <span>-</span>
                                <span class="bthpd__week-date">
                                    <span class="bthpd__week-date-l">{{#str}}startedon, local_parent{{/str}}</span>
                                    <span class="bthpd__week-date-v">“<bdi dir="ltr">{{date}}</bdi>”</span>
                                </span>
                                {{/date}}
                            </h4>
                            {{#empty}}<span class="bthpd__empty">{{#str}}emptyweek, local_parent{{/str}}</span>{{/empty}}
                            {{^empty}}
                            <img class="bthpd__arrow bthpd__arrow--l" src="{{arrowimg}}" alt="" aria-hidden="true">
                            <img class="bthpd__arrow bthpd__arrow--r" src="{{arrowimg}}" alt="" aria-hidden="true">
                            {{/empty}}
                        </div>
                        {{^empty}}
                        <div class="bthpd__week-body" hidden>
                            <table class="bthpd__table">
                                <thead>
                                    <tr>
                                        <th scope="col"><span class="visually-hidden">{{#str}}studentlevel, local_parent{{/str}}</span></th>
                                        <th scope="col">{{#str}}col_videos, local_parent{{/str}}</th>
                                        <th scope="col">{{#str}}col_homework, local_parent{{/str}}</th>
                                        <th scope="col">{{#str}}col_exams, local_parent{{/str}}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <th scope="row">{{#str}}studentlevel, local_parent{{/str}}</th>
                                        {{#columns}}
                                        <td>
                                            {{#hasitems}}
                                            {{#items}}
                                            <div class="bthpd__item">
                                                <span class="bthpd__item-l" title="{{name}}">{{label}}</span> :
                                                {{#done}}{{donetext}} <b>{{percent}}%</b>{{#doneafter}} {{doneafter}}{{/doneafter}}{{/done}}
                                                {{#pending}}<span class="bthpd__pending">{{pendingtext}}</span>{{/pending}}
                                                {{#absent}}<span class="bthpd__missed">{{absenttext}}</span>{{/absent}}
                                            </div>
                                            {{/items}}
                                            {{/hasitems}}
                                            {{^hasitems}}{{none}}{{/hasitems}}
                                        </td>
                                        {{/columns}}
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        {{/empty}}
                    </div>
                    {{/sections}}
                </div>
                {{/hassections}}
            </div>
            {{/courses}}
            {{/hascourses}}
        </div>
    </div>
    {{/verified}}
</div>
{{#js}}
(function() {
    var root = document.getElementById('bthpd');
    if (!root) {
        return;
    }
    var prompt = root.querySelector('[data-bthpd-prompt]');

    function toggleWeeks(btn, open) {
        var weeks = btn.closest('.bthpd__stats').querySelector('.bthpd__weeks');
        open = open === undefined ? btn.getAttribute('aria-expanded') !== 'true' : open;
        btn.setAttribute('aria-expanded', String(open));
        if (weeks) {
            weeks.hidden = !open;
        }
    }

    function chooseCourse(id) {
        root.querySelectorAll('.bthpd__course').forEach(function(c) {
            c.setAttribute('aria-pressed', String(c.getAttribute('data-course') === id));
        });
        root.querySelectorAll('[data-bthpd-stats]').forEach(function(panel) {
            var show = panel.getAttribute('data-bthpd-stats') === id;
            panel.hidden = !show;
            var btn = panel.querySelector('.bthpd__toggle');
            if (btn) {
                toggleWeeks(btn, false);
            }
        });
        if (prompt) {
            prompt.hidden = true;
        }
    }

    function toggleWeek(head) {
        var open = head.getAttribute('aria-expanded') !== 'true';
        head.setAttribute('aria-expanded', String(open));
        head.parentNode.querySelector('.bthpd__week-body').hidden = !open;
    }

    root.addEventListener('click', function(e) {
        var el = e.target.closest('.bthpd__course');
        if (el) {
            chooseCourse(el.getAttribute('data-course'));
            return;
        }
        el = e.target.closest('.bthpd__hand');
        if (el) {
            var collapsed = el.closest('.bthpd__nav').classList.toggle('is-collapsed');
            el.setAttribute('aria-expanded', String(!collapsed));
            return;
        }
        el = e.target.closest('.bthpd__toggle');
        if (el) {
            toggleWeeks(el);
            return;
        }
        el = e.target.closest('.bthpd__week-head[role="button"]');
        if (el) {
            toggleWeek(el);
        }
    });
    root.addEventListener('keydown', function(e) {
        var head = e.target.closest('.bthpd__week-head[role="button"]');
        if (head && (e.key === 'Enter' || e.key === ' ')) {
            e.preventDefault();
            toggleWeek(head);
        }
    });

    // Keep phone fields to phone characters only.
    root.querySelectorAll('.bthpd__group input').forEach(function(input) {
        input.addEventListener('input', function() {
            var clean = this.value.replace(/[^0-9+\s\-()]/g, '');
            if (clean !== this.value) {
                this.value = clean;
            }
        });
    });
})();
{{/js}}
