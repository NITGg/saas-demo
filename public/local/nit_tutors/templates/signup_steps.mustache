{{!
    @template local_nit_tutors/signup_steps

    Steps 2–5 of the teacher sign-up inside /local/academy/register.php?as=teacher (its wizard, CSS
    and step JS: .reg-step, .reg-cell, .reg-field, data-next / data-prev). Step 1 (the account) is the
    page's own. Inputs: local_nit_tutors\local\teacher_input names; values: profile_view::inputs(0).
    An element's id is f_<error key> so the page marks a server error on it and opens its step.

    Context variables required for this template: those of profile_view::inputs(), plus
    * agree - the terms box was ticked
    * filesagain - the page came back with errors: chosen files must be chosen again

    Example context (json):
    {"headline": "", "bio": "", "subjects": [], "hassubjects": false, "islink": true, "isupload": false, "videourl": "",
     "videorequired": true, "videoaccept": ".mp4", "videomax": "200 MB", "quals": [{"row": 0, "id": 0, "title": "",
     "institution": "", "year": "", "error": ""}], "nextqual": 1, "maxquals": 10, "minquals": 1, "fileaccept": ".pdf",
     "filemax": "10 MB", "hasextra": false, "extra": [], "err": {}, "agree": false, "filesagain": false}
}}
<!-- STEP 2: about you -->
<div class="reg-step" data-step="2">
  <h2 class="nittu-su__h">{{#str}}form_about, local_nit_tutors{{/str}}</h2>
  <div class="nit-reg-grid one">
    <div class="reg-cell"><div class="reg-field">
      <input type="text" name="headline" id="f_headline" placeholder=" " value="{{headline}}" maxlength="255">
      <span class="reg-lab"><span>{{#str}}form_headline, local_nit_tutors{{/str}}</span></span>
    </div><div class="reg-hint">{{#str}}form_headline_ph, local_nit_tutors{{/str}}</div><div class="reg-err"></div></div>
  </div>
  <div class="nit-reg-grid one nit-reg-row">
    <div class="reg-cell"><div class="reg-field nittu-su__area">
      <textarea name="bio" id="f_bio" rows="5" placeholder="{{#str}}form_bio_ph, local_nit_tutors{{/str}}">{{bio}}</textarea>
    </div><div class="reg-hint">{{#str}}form_bio, local_nit_tutors{{/str}} *</div><div class="reg-err"></div></div>
  </div>
  <div class="nit-reg-row reg-cell">
    <div class="nittu-su__lbl">{{#str}}form_subjects, local_nit_tutors{{/str}} *</div>
    <input type="hidden" id="f_subjects">
    <div class="nittu-chips nittu-su__chips" role="group" aria-label="{{#str}}form_subjects, local_nit_tutors{{/str}}">
      {{#subjects}}<label class="nittu-chip"><input type="checkbox" name="subjects[]" value="{{value}}" {{#checked}}checked{{/checked}}><span>{{label}}</span></label>{{/subjects}}
    </div>
    <div class="reg-err"></div>
  </div>
  <div class="nit-reg-btns"><button type="button" class="btn-prev" data-prev>{{#str}}previous{{/str}}</button><button type="button" class="btn-next" data-next>{{#str}}next{{/str}}</button></div>
</div>

<!-- STEP 3: intro video -->
<div class="reg-step" data-step="3">
  <h2 class="nittu-su__h">{{#str}}form_video, local_nit_tutors{{/str}}{{#videorequired}} *{{/videorequired}}</h2>
  <p class="nittu-su__help">{{#str}}form_video_help, local_nit_tutors{{/str}}</p>
  <div class="reg-cell" data-nittu-video data-required="{{#videorequired}}1{{/videorequired}}" data-accept="{{videoaccept}}" data-maxbytes="{{videomaxbytes}}">
    <input type="hidden" id="f_video">
    <div class="nittu-seg nittu-su__seg" role="radiogroup" aria-label="{{#str}}form_videotype, local_nit_tutors{{/str}}">
      <label><input type="radio" name="videotype" value="link" {{#islink}}checked{{/islink}} data-nittu-vtype><span>{{#str}}form_videotype_link, local_nit_tutors{{/str}}</span></label>
      <label><input type="radio" name="videotype" value="upload" {{#isupload}}checked{{/isupload}} data-nittu-vtype><span>{{#str}}form_videotype_upload, local_nit_tutors{{/str}}</span></label>
    </div>
    <div class="nit-reg-row" data-nittu-vpane="link" {{^islink}}hidden{{/islink}}>
      <div class="reg-field"><input type="url" name="videourl" placeholder=" " value="{{videourl}}" dir="ltr">
        <span class="reg-lab"><span>{{#str}}form_videourl, local_nit_tutors{{/str}}</span></span></div>
      <div class="reg-hint">https://www.youtube.com/watch?v=… · https://vimeo.com/…</div>
    </div>
    <div class="nit-reg-row" data-nittu-vpane="upload" {{^isupload}}hidden{{/isupload}}>
      <input class="nittu-su__file" type="file" name="videofile" accept="{{videoaccept}}" aria-label="{{#str}}form_videofile, local_nit_tutors{{/str}}">
      <div class="reg-hint">{{#str}}filelimit, local_nit_tutors, {{videomax}}{{/str}}</div>
    </div>
    <div class="reg-err"></div>
  </div>
  <div class="nit-reg-btns"><button type="button" class="btn-prev" data-prev>{{#str}}previous{{/str}}</button><button type="button" class="btn-next" data-next>{{#str}}next{{/str}}</button></div>
</div>

<!-- STEP 4: qualifications -->
<div class="reg-step" data-step="4">
  <h2 class="nittu-su__h">{{#str}}form_quals, local_nit_tutors{{/str}}{{#minquals}} *{{/minquals}}</h2>
  <p class="nittu-su__help">{{#str}}form_quals_help, local_nit_tutors{{/str}}</p>
  <div class="reg-cell" data-nittu-qualscell><input type="hidden" id="f_quals"><div class="reg-err"></div></div>
  <div data-nittu-quals data-nittu-nextrow="{{nextqual}}" data-max="{{maxquals}}" data-min="{{minquals}}"
       data-accept="{{fileaccept}}" data-maxbytes="{{filemaxbytes}}">
    {{#quals}}
    <div class="nittu-su__qual reg-cell" data-nittu-qual>
      <input type="hidden" id="f_qual{{row}}">
      <input type="hidden" name="qualid[{{row}}]" value="0">
      <div class="reg-field"><input type="text" name="qualtitle[{{row}}]" placeholder=" " value="{{title}}">
        <span class="reg-lab"><span>{{#str}}form_qualtitle, local_nit_tutors{{/str}}</span></span></div>
      <div class="nit-reg-grid nit-reg-row">
        <div class="reg-field"><input type="text" name="qualinstitution[{{row}}]" placeholder=" " value="{{institution}}">
          <span class="reg-lab"><span>{{#str}}form_qualinstitution, local_nit_tutors{{/str}}</span></span></div>
        <div class="reg-field"><input type="number" min="1950" max="2100" name="qualyear[{{row}}]" placeholder=" " value="{{year}}" dir="ltr">
          <span class="reg-lab"><span>{{#str}}form_qualyear, local_nit_tutors{{/str}}</span></span></div>
      </div>
      <div class="nit-reg-row"><div class="nittu-su__lbl">{{#str}}form_qualfile, local_nit_tutors{{/str}}</div>
        <input class="nittu-su__file" type="file" name="qualfile[{{row}}]" accept="{{fileaccept}}"></div>
      <div class="reg-err"></div>
    </div>
    {{/quals}}
    <button type="button" class="btn-prev nittu-su__add" data-nittu-addqual>+ {{#str}}form_qualadd, local_nit_tutors{{/str}}</button>
  </div>
  <template data-nittu-qualtpl>
    <div class="nittu-su__qual reg-cell" data-nittu-qual>
      <input type="hidden" name="qualid[__ROW__]" value="0">
      <div class="reg-field"><input type="text" name="qualtitle[__ROW__]" placeholder=" ">
        <span class="reg-lab"><span>{{#str}}form_qualtitle, local_nit_tutors{{/str}}</span></span></div>
      <div class="nit-reg-grid nit-reg-row">
        <div class="reg-field"><input type="text" name="qualinstitution[__ROW__]" placeholder=" ">
          <span class="reg-lab"><span>{{#str}}form_qualinstitution, local_nit_tutors{{/str}}</span></span></div>
        <div class="reg-field"><input type="number" min="1950" max="2100" name="qualyear[__ROW__]" placeholder=" " dir="ltr">
          <span class="reg-lab"><span>{{#str}}form_qualyear, local_nit_tutors{{/str}}</span></span></div>
      </div>
      <div class="nit-reg-row"><div class="nittu-su__lbl">{{#str}}form_qualfile, local_nit_tutors{{/str}}</div>
        <input class="nittu-su__file" type="file" name="qualfile[__ROW__]" accept="{{fileaccept}}"></div>
      <div class="reg-err"></div>
    </div>
  </template>
  <div class="reg-hint">{{#str}}filelimit, local_nit_tutors, {{filemax}}{{/str}}</div>
  <div class="nit-reg-btns"><button type="button" class="btn-prev" data-prev>{{#str}}previous{{/str}}</button><button type="button" class="btn-next" data-next>{{#str}}next{{/str}}</button></div>
</div>

<!-- STEP 5: the admin's fields, terms, send -->
<div class="reg-step" data-step="5">
  <h2 class="nittu-su__h">{{#hasextra}}{{#str}}form_more, local_nit_tutors{{/str}}{{/hasextra}}{{^hasextra}}{{#str}}signup_laststep, local_nit_tutors{{/str}}{{/hasextra}}</h2>
  {{#extra}}
  <div class="reg-cell nit-reg-row" data-nittu-field data-type="{{datatype}}" data-required="{{#required}}1{{/required}}">
    <input type="hidden" id="f_field{{id}}">
    {{^ischeckbox}}<div class="nittu-su__lbl">{{label}}{{#required}} *{{/required}}</div>{{/ischeckbox}}
    {{#istext}}<div class="reg-field"><input type="text" name="field[{{id}}]" value="{{value}}"></div>{{/istext}}
    {{#isnumber}}<div class="reg-field"><input type="number" name="field[{{id}}]" value="{{value}}" dir="ltr"></div>{{/isnumber}}
    {{#isurl}}<div class="reg-field"><input type="url" name="field[{{id}}]" value="{{value}}" dir="ltr"></div>{{/isurl}}
    {{#isdate}}<div class="reg-field"><input type="date" name="field[{{id}}]" value="{{value}}"></div>{{/isdate}}
    {{#istextarea}}<div class="reg-field nittu-su__area"><textarea name="field[{{id}}]" rows="3">{{value}}</textarea></div>{{/istextarea}}
    {{#isselect}}<div class="reg-field reg-sel"><select name="field[{{id}}]"><option value="">{{#str}}choosedots{{/str}}</option>{{#options}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/options}}</select></div>{{/isselect}}
    {{#ischeckbox}}<input type="hidden" name="field[{{id}}]" value="0"><label class="nittu-check"><input type="checkbox" name="field[{{id}}]" value="1" {{#checked}}checked{{/checked}}> {{label}}</label>{{/ischeckbox}}
    {{#isfile}}<input class="nittu-su__file" type="file" name="fieldfile[{{id}}]" accept="{{fileaccept}}">{{/isfile}}
    {{#description}}<div class="reg-hint">{{description}}</div>{{/description}}
    <div class="reg-err"></div>
  </div>
  {{/extra}}
  <p class="nittu-su__help">{{#str}}signup_review_note, local_nit_tutors{{/str}}</p>
  {{#filesagain}}<p class="nittu-su__warn">{{#str}}signup_filesagain, local_nit_tutors{{/str}}</p>{{/filesagain}}
  <label class="nit-reg-terms"><input type="checkbox" name="agree" value="1" id="f_agree" {{#agree}}checked{{/agree}}><span>{{#str}}signup_agree, local_nit_tutors{{/str}} <a href="#" class="reg-terms-open">{{#str}}signup_terms, local_nit_tutors{{/str}}</a></span></label>
  <div class="reg-err" id="agree-err" style="margin-top:6px;"></div>
  <div class="nit-reg-btns"><button type="button" class="btn-prev" data-prev>{{#str}}previous{{/str}}</button><button type="submit" class="btn-next">{{#str}}signup_send, local_nit_tutors{{/str}}</button></div>
</div>
{{#js}}
(function() {
    var form = document.getElementById('regform');
    if (!form) {
        return;
    }
    // Video: link or upload.
    var panes = form.querySelectorAll('[data-nittu-vpane]');
    form.querySelectorAll('[data-nittu-vtype]').forEach(function(r) {
        r.addEventListener('change', function() {
            panes.forEach(function(p) { p.hidden = p.getAttribute('data-nittu-vpane') !== r.value; });
        });
    });
    // Qualifications: one more row.
    var box = form.querySelector('[data-nittu-quals]');
    var tpl = form.querySelector('[data-nittu-qualtpl]');
    var add = form.querySelector('[data-nittu-addqual]');
    if (box && tpl && add) {
        add.addEventListener('click', function() {
            if (box.querySelectorAll('[data-nittu-qual]').length >= parseInt(box.getAttribute('data-max'), 10)) {
                add.disabled = true;
                return;
            }
            var next = parseInt(box.getAttribute('data-nittu-nextrow'), 10);
            box.setAttribute('data-nittu-nextrow', next + 1);
            add.insertAdjacentHTML('beforebegin', tpl.innerHTML.replace(/__ROW__/g, String(next)));
        });
    }

    // ---- Each step is checked before "Next" (and every step before sending): the page's own
    // [data-next] / submit handlers only run when the step is right. ----
    var M = {
        bio: {{#quote}}{{#str}}js_bio, local_nit_tutors{{/str}}{{/quote}},
        subjects: {{#quote}}{{#str}}js_subjects, local_nit_tutors{{/str}}{{/quote}},
        videourl: {{#quote}}{{#str}}err_badvideourl, local_nit_tutors{{/str}}{{/quote}},
        videofile: {{#quote}}{{#str}}err_choosevideo, local_nit_tutors{{/str}}{{/quote}},
        filetype: {{#quote}}{{#str}}js_filetype, local_nit_tutors{{/str}}{{/quote}},
        filesize: {{#quote}}{{#str}}js_filesize, local_nit_tutors{{/str}}{{/quote}},
        qualtitle: {{#quote}}{{#str}}err_qualtitle, local_nit_tutors{{/str}}{{/quote}},
        qualyear: {{#quote}}{{#str}}err_qualyear, local_nit_tutors{{/str}}{{/quote}},
        quals: {{#quote}}{{#str}}missing_qualifications, local_nit_tutors, {{minquals}}{{/str}}{{/quote}},
        required: {{#quote}}{{#str}}required{{/str}}{{/quote}},
        stepof: {{#quote}}{{#str}}js_stepof, local_nit_tutors{{/str}}{{/quote}}
    };
    var VIDEO = /^https?:\/\/((www\.|m\.)?youtube\.com\/(watch\?(.*&)?v=|embed\/|shorts\/|live\/)|youtu\.be\/|(www\.)?vimeo\.com\/\d|player\.vimeo\.com\/video\/\d)/i;
    var thisyear = new Date().getFullYear();

    function mark(cell, msg) {
        cell.classList.add('invalid');
        var err = cell.querySelector('.reg-err');
        if (err) {
            err.textContent = msg;
        }
    }
    function unmark(step) {
        step.querySelectorAll('[data-nittu-checked].invalid').forEach(function(c) {
            c.classList.remove('invalid');
            var err = c.querySelector('.reg-err');
            if (err) {
                err.textContent = '';
            }
        });
    }
    // A chosen file's type and size ('' = fine or none chosen).
    function fileproblem(input, accept, maxbytes) {
        var f = input && input.files && input.files[0];
        if (!f) {
            return '';
        }
        var ext = '.' + (f.name.split('.').pop() || '').toLowerCase();
        if (accept.split(',').indexOf(ext) < 0) {
            return M.filetype.replace('%s', accept.split(',').join(' '));
        }
        return f.size > maxbytes ? M.filesize : '';
    }
    function val(scope, name) {
        var el = scope.querySelector('[name="' + name + '"]');
        return el ? (el.value || '').trim() : '';
    }

    // The checks of one step: [cell, message] pairs; none = the step is right.
    function problems(step) {
        var out = [];
        var n = step.getAttribute('data-step');
        if (n === '2') {
            if (!val(step, 'bio')) {
                out.push([form.querySelector('#f_bio').closest('.reg-cell'), M.bio]);
            }
            if (!step.querySelector('input[name="subjects[]"]:checked')) {
                out.push([form.querySelector('#f_subjects').closest('.reg-cell'), M.subjects]);
            }
        } else if (n === '3') {
            var cell = step.querySelector('[data-nittu-video]');
            var type = (step.querySelector('input[name="videotype"]:checked') || {}).value;
            var required = cell.getAttribute('data-required') === '1';
            if (type === 'upload') {
                var file = step.querySelector('input[name="videofile"]');
                var p = fileproblem(file, cell.getAttribute('data-accept'), parseInt(cell.getAttribute('data-maxbytes'), 10));
                if (p) {
                    out.push([cell, p]);
                } else if (required && !(file.files && file.files.length)) {
                    out.push([cell, M.videofile]);
                }
            } else {
                var url = val(step, 'videourl');
                if ((url || required) && !VIDEO.test(url)) {
                    out.push([cell, M.videourl]);
                }
            }
        } else if (n === '4') {
            var box = step.querySelector('[data-nittu-quals]');
            var filled = 0;
            step.querySelectorAll('[data-nittu-qual]').forEach(function(row) {
                var title = (row.querySelector('[name^="qualtitle"]').value || '').trim();
                var inst = (row.querySelector('[name^="qualinstitution"]').value || '').trim();
                var year = (row.querySelector('[name^="qualyear"]').value || '').trim();
                var file = row.querySelector('[name^="qualfile"]');
                var hasfile = file && file.files && file.files.length;
                if (!title && !inst && !year && !hasfile) {
                    return; // An empty row.
                }
                if (!title) {
                    out.push([row, M.qualtitle]);
                } else if (year && (+year < 1950 || +year > thisyear + 1)) {
                    out.push([row, M.qualyear]);
                } else {
                    var fp = fileproblem(file, box.getAttribute('data-accept'), parseInt(box.getAttribute('data-maxbytes'), 10));
                    if (fp) {
                        out.push([row, fp]);
                    }
                }
                filled += title ? 1 : 0;
            });
            if (filled < parseInt(box.getAttribute('data-min'), 10)) {
                out.push([step.querySelector('[data-nittu-qualscell]'), M.quals]);
            }
        } else if (n === '5') {
            step.querySelectorAll('[data-nittu-field]').forEach(function(cell) {
                if (cell.getAttribute('data-required') !== '1') {
                    return;
                }
                var type = cell.getAttribute('data-type');
                var ok;
                if (type === 'checkbox') {
                    ok = cell.querySelector('input[type=checkbox]').checked;
                } else if (type === 'file') {
                    var f = cell.querySelector('input[type=file]');
                    ok = f.files && f.files.length;
                } else {
                    var input = cell.querySelector('input:not([type=hidden]), select, textarea');
                    ok = input && (input.value || '').trim() !== '';
                }
                if (!ok) {
                    out.push([cell, M.required]);
                }
            });
        }
        return out;
    }
    function check(step) {
        unmark(step);
        var list = problems(step);
        list.forEach(function(p) {
            p[0].setAttribute('data-nittu-checked', '1');
            mark(p[0], p[1]);
        });
        if (list.length) {
            try { list[0][0].scrollIntoView({block: 'center', behavior: 'smooth'}); } catch (e) { /* Old browsers. */ }
        }
        return !list.length;
    }
    // Open a step the way the page does (progress bar included).
    function open(step) {
        var steps = [].slice.call(form.querySelectorAll('.reg-step'));
        var i = steps.indexOf(step);
        steps.forEach(function(s, k) { s.classList.toggle('active', k === i); });
        var pct = Math.round((i + 1) * 100 / steps.length) + '%';
        var label = M.stepof.replace('%s', i + 1).replace('%n', steps.length);
        var el = document.getElementById('reg-pct');
        if (el) { el.textContent = pct; }
        el = document.getElementById('reg-step-label');
        if (el) { el.textContent = label; }
        el = document.getElementById('reg-fill');
        if (el) { el.style.width = pct; }
    }

    // Capture phase: runs before the page's own handlers, and stops them when the step is wrong.
    document.addEventListener('click', function(e) {
        var next = e.target.closest && e.target.closest('button[data-next]');
        if (!next || !form.contains(next)) {
            return;
        }
        if (!check(next.closest('.reg-step'))) {
            e.stopPropagation();
            e.preventDefault();
        }
    }, true);
    document.addEventListener('submit', function(e) {
        if (e.target !== form) {
            return;
        }
        var steps = form.querySelectorAll('.reg-step');
        for (var i = 0; i < steps.length; i++) {
            if (!check(steps[i])) {
                e.preventDefault();
                e.stopImmediatePropagation();
                open(steps[i]);
                return;
            }
        }
    }, true);
    // Fixing a field clears its message.
    form.addEventListener('change', function(e) {
        var cell = e.target.closest && e.target.closest('[data-nittu-checked].invalid');
        if (cell) {
            cell.classList.remove('invalid');
            var err = cell.querySelector('.reg-err');
            if (err) {
                err.textContent = '';
            }
        }
    });
})();
{{/js}}
