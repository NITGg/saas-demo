{{!
    @template local_nit_tutors/application_status

    The status banner above the teacher's application form.

    Context variables required for this template:
    * status, tone, title, help - the application state
    * note - the reviewer's message (reason / what to change), may be empty
    * hasmissing, missing - [{label}] what still blocks sending it for review
    * pageurl - the public teacher page once approved
    * badges - [{name, color, description}] the badges the teacher wears

    Example context (json):
    {"status": "changes", "tone": "warning", "title": "Changes requested", "help": "Update and send again.",
     "note": "Please add your degree certificate.", "hasmissing": true, "missing": [{"label": "Intro video"}],
     "pageurl": "", "badges": []}
}}
<div class="nit-prof-card nittu-status nittu-status--{{tone}}" data-status="{{status}}">
    <div class="nittu-status__head">
        <span class="nittu-status__pill">{{title}}</span>
        {{#badges}}<span class="nittu-badge nittu-badge--{{color}}" title="{{description}}">{{name}}</span>{{/badges}}
        {{#pageurl}}<a class="btn-out nittu-status__link" href="{{pageurl}}">{{#str}}viewpublicpage, local_nit_tutors{{/str}}</a>{{/pageurl}}
    </div>
    <p class="nittu-status__help">{{help}}</p>
    {{#note}}
    <div class="nittu-status__note"><strong>{{#str}}reviewnote, local_nit_tutors{{/str}}:</strong> {{{note}}}</div>
    {{/note}}
    {{#hasmissing}}
    <div class="nittu-status__missing">
        <strong>{{#str}}stillmissing, local_nit_tutors{{/str}}:</strong>
        <ul>{{#missing}}<li>{{label}}</li>{{/missing}}</ul>
    </div>
    {{/hasmissing}}
</div>
