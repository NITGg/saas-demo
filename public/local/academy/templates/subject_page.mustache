{{!
    @template local_academy/subject_page

    The public subject page (local/academy/subject.php) — bassthalk.com/subject/<id>:
    the subject of one year, its teachers and its courses. Built on the teacher page's
    look (.bthtp, theme/nit/scss/components/_bthteacher.scss, block "Subject page");
    colours from Brand Colors → Bassthalk (the wrapper carries .nit-brand-18).

    Context variables required for this template:
    * name, year - the subject and its year
    * teachers - [{id, name, photo, title, url}]
    * hasteachers - whether there are teachers
    * counts - {teachers, courses}
    * courses - course cards (see local_academy/course_card)
    * browseurl - the course catalogue

    Example context (json):
    {
        "name": "اللغة الألمانية", "year": "الصف الثالث الثانوي", "hasteachers": true,
        "teachers": [{"id": 3, "name": "أحمد الشرقاوي", "photo": "", "title": "", "url": "#"}],
        "counts": {"teachers": 1, "courses": 1}, "browseurl": "#",
        "courses": [{"id": 2, "fullname": "First Month", "url": "#", "enrolurl": "#", "image": "", "year": "٣ ث",
            "price": "420 جنيه", "summary": "", "createdtext": "", "modifiedtext": "", "enrolled": false, "free": false}]
    }
}}
<div class="bthtp bthtp--subject nit-brand-18" data-bthtp>
    <section class="bthtp__hero">
        <div class="bthtp__pattern" aria-hidden="true"></div>
        <div class="bthtp__hero-in">
            <div class="bthtp__info">
                <ul class="bthtp__chips">
                    <li class="bthtp__chip">
                        <span class="bthtp__chip-num">+ {{counts.teachers}}</span>
                        <span class="bthtp__tag bthtp__tag--years">{{#str}}subjectpage_teachers, local_academy{{/str}}</span>
                    </li>
                    <li class="bthtp__chip">
                        <span class="bthtp__chip-num">+ {{counts.courses}}</span>
                        <span class="bthtp__tag bthtp__tag--courses">{{#str}}teacherpage_courses, local_academy{{/str}}</span>
                    </li>
                </ul>
                <p class="bthtp__title">{{year}}</p>
                <h1 class="bthtp__name">{{name}}</h1>
                {{#hasteachers}}
                <ul class="bthtp__pills">
                    {{#teachers}}<li><a class="bthtp__pill" href="{{url}}">{{name}}</a></li>{{/teachers}}
                </ul>
                {{/hasteachers}}
            </div>
        </div>
    </section>

    <div class="bthtp__body">
        <aside class="bthtp__card">
            <dl class="bthtp__stats">
                <div class="bthtp__stat">
                    <dt>
                        <svg class="bthtp__ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3s1.34 3 3 3m-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5S5 6.34 5 8s1.34 3 3 3m0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5m8 0c-.29 0-.62.02-.97.05c1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5"/></svg>
                        {{#str}}subjectpage_teachercount, local_academy{{/str}}
                    </dt>
                    <dd>{{counts.teachers}}</dd>
                </div>
                <div class="bthtp__stat">
                    <dt>
                        <svg class="bthtp__ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4 6H2v14a2 2 0 0 0 2 2h14v-2H4zm16-4H8a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2m0 14H8V4h12zM10 9h8v2h-8zm0 3h4v2h-4zm0-6h8v2h-8z"/></svg>
                        {{#str}}teacherpage_coursecount, local_academy{{/str}}
                    </dt>
                    <dd>{{counts.courses}}</dd>
                </div>
            </dl>
        </aside>
    </div>

    <section class="bthtp__courses" aria-labelledby="bthtp-teachers-h">
        <div class="bthtp__head">
            <span class="bthtp__rule" aria-hidden="true"></span>
            <h2 class="bthtp__h2" id="bthtp-teachers-h">{{#str}}subjectpage_teachersh1, local_academy{{/str}} <span>{{#str}}subjectpage_heading2, local_academy{{/str}}</span></h2>
            <span class="bthtp__rule bthtp__rule--end" aria-hidden="true"></span>
        </div>
        {{#hasteachers}}
        <ul class="bthtp__teachers">
            {{#teachers}}
            <li>
                <a class="bthtp__tcard" href="{{url}}">
                    <img class="bthtp__tphoto" src="{{photo}}" alt="" loading="lazy">
                    <span class="bthtp__tname">{{name}}</span>
                    {{#title}}<span class="bthtp__ttitle">{{title}}</span>{{/title}}
                </a>
            </li>
            {{/teachers}}
        </ul>
        {{/hasteachers}}
        {{^hasteachers}}
        <div class="bthtp__noteachers">
            <h3>{{#str}}subjectpage_noteachers, local_academy{{/str}}</h3>
            <p>{{#str}}subjectpage_noteachers_desc, local_academy{{/str}}</p>
            <a class="bthtp__btn bthtp__btn--fill" href="{{browseurl}}">{{#str}}subjectpage_browse, local_academy{{/str}}</a>
        </div>
        {{/hasteachers}}
    </section>

    <section class="bthtp__courses" aria-labelledby="bthtp-courses-h">
        <div class="bthtp__head">
            <span class="bthtp__rule" aria-hidden="true"></span>
            <h2 class="bthtp__h2" id="bthtp-courses-h">{{#str}}subjectpage_coursesh1, local_academy{{/str}} <span>{{#str}}subjectpage_heading2, local_academy{{/str}}</span></h2>
            <span class="bthtp__rule bthtp__rule--end" aria-hidden="true"></span>
        </div>
        <div class="bthtp__grid">
            {{#courses}}
            {{> local_academy/course_card }}
            {{/courses}}
        </div>
    </section>
</div>
{{> local_academy/course_cards_js }}
