{{!
    @template local_nit_finance/buy_page

    Unlock one lesson (local/nit_finance/buy.php): wallet or code.

    Example context (json):
    {
        "coursename": "Physics", "name": "Lesson 1", "priced": true, "price": "50 EGP", "balance": "20 EGP",
        "canpay": false, "paylabel": "Pay 50 EGP from my wallet", "action": "#", "cmid": 5, "sesskey": "abc",
        "redeem": {"action": "#", "params": [{"name": "cmid", "value": 5}], "sesskey": "abc"},
        "courseurl": "#", "coursebuyurl": "#", "walleturl": "#"
    }
}}
<div class="nitfin nit-brand-18">
    <div class="nitfin__wrap nitfin__wrap--narrow">
        <div class="nitfin-card nitfin-buy">
            <div class="nitfin-buy__lock" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
            </div>
            <p class="nitfin-buy__course">{{coursename}}</p>
            <h1 class="nitfin-buy__name">{{name}}</h1>

            {{#priced}}
            <p class="nitfin-buy__intro">{{#str}}buyintro, local_nit_finance{{/str}}</p>
            <dl class="nitfin-buy__facts">
                <div class="nitfin-buy__fact">
                    <dt>{{#str}}price, local_nit_finance{{/str}}</dt>
                    <dd class="nitfin-buy__price">{{price}}</dd>
                </div>
                <div class="nitfin-buy__fact">
                    <dt>{{#str}}yourbalance, local_nit_finance{{/str}}</dt>
                    <dd>{{balance}}</dd>
                </div>
            </dl>
            {{#canpay}}
            <form method="post" action="{{action}}" class="nitfin-buy__pay">
                <input type="hidden" name="cmid" value="{{cmid}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="action" value="buy">
                <button type="submit" class="nitfin-btn nitfin-btn--block">{{paylabel}}</button>
            </form>
            {{/canpay}}
            {{^canpay}}
            <p class="nitfin-note" role="status">{{#str}}notenoughbalance, local_nit_finance{{/str}}</p>
            {{#topup}}<div class="nitfin-buy__topup">{{> local_nit_finance/topup_form}}</div>{{/topup}}
            {{/canpay}}
            {{/priced}}
            {{^priced}}
            <p class="nitfin-buy__intro">{{#str}}lessonlockedcourse, local_nit_finance{{/str}}</p>
            {{/priced}}

            {{#coursebuyurl}}
            <a class="nitfin-btn nitfin-btn--outline nitfin-btn--block" href="{{coursebuyurl}}">{{#str}}buycourse, local_nit_finance{{/str}}</a>
            {{/coursebuyurl}}

            <div class="nitfin-or"><span>{{#str}}or, local_nit_finance{{/str}}</span></div>
            {{#redeem}}{{> local_nit_finance/redeem_form}}{{/redeem}}

            <div class="nitfin-buy__links">
                <a href="{{courseurl}}">{{#str}}backtocourse, local_nit_finance{{/str}}</a>
                <a href="{{walleturl}}">{{#str}}mywallet, local_nit_finance{{/str}}</a>
            </div>
        </div>
    </div>
</div>
