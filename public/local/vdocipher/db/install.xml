<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/vdocipher/db" VERSION="2026081201"
       COMMENT="VdoCipher: maps course activities to VdoCipher videos.">
  <TABLES>
    <TABLE NAME="local_vdocipher_videos" COMMENT="One row per VdoCipher video, optionally attached to a course module (resource2)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="videoid" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="VdoCipher video id"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Attached course module id (0 = not yet attached)"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="PRE-Upload" SEQUENCE="false" COMMENT="Last known VdoCipher status: PRE-Upload|Queued|Processing|ready|…"/>
        <FIELD NAME="length" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Duration in seconds (0 until processed)"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="User who created / last changed this video"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="videoid_idx" UNIQUE="true" FIELDS="videoid"/>
        <INDEX NAME="cmid_idx" UNIQUE="false" FIELDS="cmid"/>
        <INDEX NAME="courseid_idx" UNIQUE="false" FIELDS="courseid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
