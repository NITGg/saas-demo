{{!
    @template local_nit_ai/quizgen_review

    Everything the generator wrote, before any of it becomes a question.

    Each question shows the moment of the video it came from, so a reviewer can
    check it against the lesson rather than against their memory of it. The
    coverage summary is above the questions on purpose: whether the quiz reaches
    the whole video is the one thing that cannot be judged question by question.

    Context variables required for this template:
    * actionurl - where the form posts
    * runid, cmid, sesskey - identify the run being confirmed
    * levels - one group per level, each with its questions
    * percent - share of the examinable video the questions reach
    * gaps - stretches with no question against them
    * skippedparts - stretches reported as having nothing to examine

    Example context (json):
    {
        "actionurl": "/local/nit_ai/quizgen.php",
        "cmid": 49,
        "runid": 12,
        "sesskey": "abc123",
        "quizname": "Lesson 3 - quiz",
        "total": 18,
        "percent": 96,
        "hasquestions": true,
        "hasgaps": false,
        "hasskipped": false,
        "cancelurl": "/mod/vdocipher/view.php?id=49",
        "strreview": "Nothing here is a question yet.",
        "strcoveragesummary": "18 questions covering 96% of the video.",
        "strgapstitle": "Not asked about",
        "strskippedtitle": "Nothing to examine here",
        "strquizname": "Quiz name",
        "strcreate": "Create the quiz",
        "strhidden": "The quiz is created hidden.",
        "strcancel": "Cancel",
        "strkeep": "Keep",
        "strmarks": "marks each",
        "strnothing": "There is nothing to build."
    }
}}
<form method="post" action="{{actionurl}}" class="nitai-quizgen-review">
    <input type="hidden" name="cmid" value="{{cmid}}">
    <input type="hidden" name="run" value="{{runid}}">
    <input type="hidden" name="review" value="1">
    <input type="hidden" name="create" value="1">
    <input type="hidden" name="sesskey" value="{{sesskey}}">

    <div class="card mb-3">
        <div class="card-body">
            <p class="mb-2">{{strcoveragesummary}}</p>

            <div class="progress mb-3" role="progressbar" aria-valuemin="0" aria-valuemax="100"
                 aria-valuenow="{{percent}}">
                <div class="progress-bar bg-success" style="width: {{percent}}%"></div>
            </div>

            <p class="text-muted small mb-1">{{strspan}}</p>
            <p class="text-muted small mb-0">{{strreview}}</p>

            {{#spanmismatch}}
                <div class="alert alert-warning mt-3 mb-0" role="alert">{{strspanwarning}}</div>
            {{/spanmismatch}}

            {{#hasgaps}}
                <div class="alert alert-warning mt-3 mb-0" role="status">
                    <strong class="d-block mb-1">{{strgapstitle}}</strong>
                    <ul class="mb-0 ps-3">
                        {{#gaps}}<li>{{label}}</li>{{/gaps}}
                    </ul>
                </div>
            {{/hasgaps}}

            {{#hasskipped}}
                <div class="alert alert-info mt-3 mb-0" role="status">
                    <strong class="d-block mb-1">{{strskippedtitle}}</strong>
                    <ul class="mb-0 ps-3">
                        {{#skippedparts}}<li>{{label}} — {{reason}}</li>{{/skippedparts}}
                    </ul>
                </div>
            {{/hasskipped}}
        </div>
    </div>

    {{^hasquestions}}
        <div class="alert alert-warning" role="alert">{{strnothing}}</div>
    {{/hasquestions}}

    {{#levels}}
        <div class="card mb-3 nitai-quizgen-level">
            <div class="card-body">
                <h3 class="h6 mb-3">{{name}} <span class="text-muted fw-normal">— {{count}} · {{mark}} {{strmarks}}</span></h3>

                {{#questions}}
                    <div class="nitai-quizgen-question">
                        <div class="form-check mb-1">
                            <input class="form-check-input" type="checkbox" name="keep[]" value="{{position}}"
                                   id="nitai-q-{{position}}" checked>
                            <label class="form-check-label fw-bold" for="nitai-q-{{position}}">
                                {{number}}. {{stem}}
                            </label>
                        </div>

                        <ul class="nitai-quizgen-answers">
                            {{#answers}}
                                <li class="{{#correct}}nitai-correct{{/correct}}">{{text}}</li>
                            {{/answers}}
                        </ul>

                        <p class="text-muted small mb-0">
                            {{#time}}<span class="nitai-quizgen-time">{{time}}</span>{{/time}}
                            {{explanation}}
                        </p>
                    </div>
                {{/questions}}
            </div>
        </div>
    {{/levels}}

    <div class="card mb-3">
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label" for="nitai-quizname">{{strquizname}}</label>
                <input type="text" class="form-control" id="nitai-quizname" name="quizname"
                       value="{{quizname}}" size="60">
            </div>

            <button type="submit" class="btn btn-primary">{{strcreate}}</button>
            <a href="{{cancelurl}}" class="btn btn-secondary">{{strcancel}}</a>
            <p class="text-muted small mt-2 mb-0">{{strhidden}}</p>
        </div>
    </div>
</form>
