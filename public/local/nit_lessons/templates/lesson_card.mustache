{{!
    @template local_nit_lessons/lesson_card

    One live lesson with its action buttons (see local_nit_lessons/lesson_dialog).

    Example context (json):
    {
        "id": 3, "subject": "Physics", "with": "With Mr Ali", "when": "Monday, 5 October 2026, 5:00 PM",
        "confirmed": true, "status": "confirmed", "statuslabel": "Confirmed", "note": "Chapter 2",
        "rejectreason": "", "cancelreason": "", "flex": "Flex booked", "suggested": "", "reschedule": "",
        "hasactions": true, "joinurl": "",
        "actions": [{"do": "start", "value": "", "label": "Start", "need": "none", "style": "primary", "confirm": ""}]
    }
}}
<article class="nitlx-lesson nitlx-lesson--{{status}}" {{#slots}}data-slots="{{slots}}"{{/slots}}>
    <header class="nitlx-lesson__head">
        <div>
            <h3 class="nitlx-lesson__subject">{{subject}}</h3>
            <p class="nitlx-lesson__with">{{with}}</p>
        </div>
        <span class="nitlx-badge nitlx-badge--{{status}}">{{statuslabel}}</span>
    </header>
    <ul class="nitlx-lesson__facts">
        <li>{{#pix}}i/calendar, core{{/pix}}
            {{#confirmed}}{{#str}}lesson_at, local_nit_lessons{{/str}} {{when}}{{/confirmed}}
            {{^confirmed}}{{#str}}lesson_requestedfor, local_nit_lessons{{/str}} {{when}}{{/confirmed}}</li>
        {{#flex}}<li>{{#pix}}i/star, core{{/pix}}{{flex}}</li>{{/flex}}
        {{#note}}<li>{{#pix}}i/edit, core{{/pix}}{{note}}</li>{{/note}}
        {{#rejectreason}}<li class="nitlx-lesson__reason"><strong>{{#str}}rejectreason, local_nit_lessons{{/str}}</strong> {{rejectreason}}</li>{{/rejectreason}}
        {{#cancelreason}}<li class="nitlx-lesson__reason"><strong>{{#str}}cancelreason, local_nit_lessons{{/str}}</strong> {{cancelreason}}</li>{{/cancelreason}}
    </ul>
    {{#suggested}}<p class="nitlx-lesson__notice">{{suggested}}</p>{{/suggested}}
    {{#reschedule}}<p class="nitlx-lesson__notice">{{reschedule}}</p>{{/reschedule}}
    {{#hasactions}}
    <div class="nitlx-lesson__actions">
        {{#joinurl}}<a class="nitfin-btn nitfin-btn--small nitlx-join" href="{{joinurl}}" target="_blank" rel="noopener">{{#str}}act_join, local_nit_lessons{{/str}}</a>{{/joinurl}}
        {{#recordingurl}}<a class="nitfin-btn nitfin-btn--small nitfin-btn--outline nitlx-recbtn" href="{{recordingurl}}">{{#pix}}i/play, core{{/pix}} {{recordinglabel}}</a>{{/recordingurl}}
        {{#actions}}
        <button type="button" class="nitlx-actbtn nitlx-actbtn--{{style}}" data-act="{{do}}" data-value="{{value}}"
                data-need="{{need}}" data-lesson="{{id}}" data-confirm="{{confirm}}" data-title="{{label}}">{{label}}</button>
        {{/actions}}
    </div>
    {{/hasactions}}
</article>
