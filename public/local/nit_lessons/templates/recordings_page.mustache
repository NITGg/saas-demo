{{!
    @template local_nit_lessons/recordings_page

    The recordings of one live lesson (local/nit_lessons/recording.php): the Vimeo
    player of each recording, newest first. Colours from Brand Colors → Bassthalk;
    styles in local/nit_flex/styles.css.

    Example context (json):
    {
        "title": "Recordings: Physics", "with": "with Ahmed", "when": "Saturday, 10 October 2026, 5:00 PM",
        "backurl": "#", "hasrecordings": true,
        "recordings": [{"title": "Recording", "when": "Saturday, 10 October 2026, 6:00 PM", "duration": "45 mins",
            "embedurl": "https://player.vimeo.com/video/1", "first": true}]
    }
}}
<div class="nitfin nitlx nit-brand-18">
    <div class="nitfin__wrap">
        <a class="nitlx-backlink" href="{{backurl}}">{{#str}}back{{/str}}</a>
        <h1 class="nitfin__title">{{title}}</h1>
        <p class="nitlx-intro">{{with}} · {{when}}</p>

        {{#hasrecordings}}
        <div class="nitlx-recordings">
            {{#recordings}}
            <section class="nitfin-card nitlx-recording">
                <div class="nitlx-recording__player">
                    <iframe src="{{embedurl}}" title="{{title}}" allow="autoplay; fullscreen; picture-in-picture"
                            allowfullscreen {{^first}}loading="lazy"{{/first}}></iframe>
                </div>
                <div class="nitlx-recording__meta">
                    <strong>{{title}}</strong>
                    <span>{{when}}{{#duration}} · {{duration}}{{/duration}}</span>
                </div>
            </section>
            {{/recordings}}
        </div>
        {{/hasrecordings}}
        {{^hasrecordings}}<p class="nitfin-empty">{{#str}}norecordings, local_nit_lessons{{/str}}</p>{{/hasrecordings}}
    </div>
</div>
