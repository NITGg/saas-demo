{{!
    @template local_academysessions/monitor_detail

    One lesson opened from the monitoring wall (\local_academysessions\monitor::detail()):
    its state and everyone expected or seen in it. Shown in a modal by amd/src/monitor.js.

    Example context (json):
    {
        "title": "Physics", "course": "Grade 10", "statuslabel": "Running", "colour": "success",
        "type": "Group session", "provider": "Jitsi", "timerange": "10:00 AM – 10:50 AM",
        "actualstarttext": "10:02 AM", "latetext": "", "elapsed": "12 min", "attendance": "1 / 1 in",
        "hasalert": false, "alerts": [], "updated": "10:00:05 AM",
        "people": [{"name": "Sara Ali", "role": "Teacher", "isteacher": true, "firstjoin": "10:02 AM",
            "lastleave": "", "present": true, "state": "In the call", "statecolour": "success", "minutes": "12 min"}]
    }
}}
<div class="nitmon nitmon-detail">
    <p class="nitmon-detail-head">
        <span class="nitmon-badge nitmon-badge-{{colour}}">{{statuslabel}}</span>
        <span class="nitmon-meta">{{course}} · {{type}} · {{provider}}</span>
    </p>
    {{#hasalert}}
    <ul class="nitmon-alerts" role="alert">
        {{#alerts}}<li>{{#pix}} i/warning, core {{/pix}} {{text}}</li>{{/alerts}}
    </ul>
    {{/hasalert}}
    <dl class="nitmon-facts nitmon-facts-wide">
        <div><dt>{{#str}} monitor_time, local_academysessions {{/str}}</dt><dd><bdi dir="ltr">{{timerange}}</bdi></dd></div>
        {{#actualstarttext}}
        <div><dt>{{#str}} monitor_actualstart, local_academysessions {{/str}}</dt>
            <dd><bdi dir="ltr">{{actualstarttext}}</bdi>{{#latetext}} <span class="nitmon-late">({{latetext}})</span>{{/latetext}}</dd></div>
        {{/actualstarttext}}
        {{#elapsed}}<div><dt>{{#str}} monitor_elapsed, local_academysessions {{/str}}</dt><dd>{{elapsed}}</dd></div>{{/elapsed}}
        {{#teachervisits}}<div><dt>{{#str}} monitor_teacher, local_academysessions {{/str}}</dt><dd>{{teachervisits}}</dd></div>{{/teachervisits}}
        {{#teacherlastleave}}<div><dt>{{#str}} monitor_teacherlastleave, local_academysessions {{/str}}</dt><dd><bdi dir="ltr">{{teacherlastleave}}</bdi></dd></div>{{/teacherlastleave}}
        <div><dt>{{#str}} monitor_students, local_academysessions {{/str}}</dt>
            <dd>{{attendance}}{{#studentsline}}<span class="nitmon-sub">{{studentsline}}</span>{{/studentsline}}</dd></div>
        {{#endtext}}<div><dt>{{#str}} monitor_ending, local_academysessions {{/str}}</dt>
            <dd>{{endtext}}{{#durationtext}}<span class="nitmon-sub">{{durationtext}}</span>{{/durationtext}}</dd></div>{{/endtext}}
    </dl>
    {{#joinurl}}
    <p><a class="btn btn-primary btn-sm" href="{{joinurl}}" target="_blank" rel="noopener">
        {{#pix}} i/externallink, core {{/pix}} {{#str}} monitor_join, local_academysessions {{/str}}</a>
        <span class="nitmon-note">{{#str}} monitor_joinnote, local_academysessions {{/str}}</span></p>
    {{/joinurl}}

    <div class="table-responsive">
        <table class="table table-sm nitmon-people">
            <caption class="visually-hidden">{{#str}} monitor_people, local_academysessions {{/str}}</caption>
            <thead>
                <tr>
                    <th scope="col">{{#str}} name {{/str}}</th>
                    <th scope="col">{{#str}} monitor_role, local_academysessions {{/str}}</th>
                    <th scope="col">{{#str}} status {{/str}}</th>
                    <th scope="col">{{#str}} monitor_firstjoin, local_academysessions {{/str}}</th>
                    <th scope="col">{{#str}} monitor_lastleave, local_academysessions {{/str}}</th>
                    <th scope="col">{{#str}} monitor_timein, local_academysessions {{/str}}</th>
                    <th scope="col">{{#str}} monitor_visits, local_academysessions {{/str}}</th>
                    <th scope="col">{{#str}} monitor_stretches, local_academysessions {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#people}}
                <tr {{#isteacher}}class="nitmon-people-teacher"{{/isteacher}}>
                    <th scope="row">{{name}}</th>
                    <td>{{role}}</td>
                    <td><span class="nitmon-badge nitmon-badge-{{statecolour}}">{{state}}</span></td>
                    <td><bdi dir="ltr">{{firstjoin}}</bdi>{{^firstjoin}}—{{/firstjoin}}</td>
                    <td><bdi dir="ltr">{{lastleave}}</bdi>{{^lastleave}}—{{/lastleave}}</td>
                    <td>{{minutes}}</td>
                    <td>{{visits}}</td>
                    <td class="nitmon-stretches"><bdi dir="ltr">{{stretches}}</bdi>{{^stretches}}—{{/stretches}}</td>
                </tr>
                {{/people}}
            </tbody>
        </table>
    </div>
    <p class="nitmon-updated">{{#str}} monitor_updated, local_academysessions, {{updated}} {{/str}}</p>
    <p class="nitmon-note">{{#str}} monitor_source, local_academysessions {{/str}}</p>
</div>
