<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/vimeo/db" VERSION="2026090500"
       COMMENT="Vimeo: maps course activities to Vimeo videos.">
  <TABLES>
    <TABLE NAME="local_vimeo_videos" COMMENT="One row per Vimeo video, optionally attached to a course module (resource2)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="videoid" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="Vimeo numeric video id (the number in /videos/&lt;id&gt;)"/>
        <FIELD NAME="videohash" TYPE="char" LENGTH="64" NOTNULL="true" DEFAULT="" SEQUENCE="false" COMMENT="Optional private embed hash appended to the player URL (?h=&lt;hash&gt;); empty for domain-whitelist privacy"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Attached course module id (0 = not yet attached)"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="PRE-Upload" SEQUENCE="false" COMMENT="Last known transcode status: PRE-Upload|in_progress|complete|error"/>
        <FIELD NAME="length" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Duration in seconds (0 until processed)"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="User who created / last changed this video"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="videoid_idx" UNIQUE="true" FIELDS="videoid"/>
        <INDEX NAME="cmid_idx" UNIQUE="false" FIELDS="cmid"/>
        <INDEX NAME="courseid_idx" UNIQUE="false" FIELDS="courseid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
