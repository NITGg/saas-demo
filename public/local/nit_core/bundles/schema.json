{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nit.example/schemas/bundle.schema.json",
  "title": "NIT release bundle manifest",
  "description": "Pins the exact plugin versions in a NIT release; consumed by tool_nit_provision for install and fleet upgrade.",
  "type": "object",
  "required": ["release", "sdkApi", "moodle", "php", "plugins"],
  "additionalProperties": false,
  "properties": {
    "release": {
      "type": "string",
      "pattern": "^r[0-9]+\\.[0-9]+$",
      "description": "Release train identifier, e.g. r1.0"
    },
    "sdkApi": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the local_nit_core public API"
    },
    "moodle": {
      "type": "object",
      "required": ["min", "tested"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "string", "description": "Minimum supported Moodle release, e.g. 4.5" },
        "tested": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Moodle releases this bundle was tested against"
        }
      }
    },
    "php": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Supported PHP versions"
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["component", "version"],
        "additionalProperties": false,
        "properties": {
          "component": {
            "type": "string",
            "pattern": "^[a-z]+_[a-z0-9_]+$",
            "description": "Frankenstyle component name"
          },
          "version": {
            "type": "integer",
            "description": "Plugin version.php stamp (YYYYMMDDXX)"
          }
        }
      }
    }
  }
}
