{{!
    @template local_nit_core/output/welcome_panel

    Default (SDK) rendering of the welcome panel. Themes may override this
    template to restyle it; the data contract stays the same.

    Context variables required for this template:
    * greeting - string
    * message - string
    * ctas - array of { label, url }

    Example context (json):
    {
        "greeting": "Welcome back, Sam!",
        "message": "Here is your learning at a glance.",
        "ctas": [ { "label": "Go to my courses", "url": "/my/courses.php" } ]
    }
}}
<div class="alert alert-primary d-flex flex-wrap align-items-center gap-3" role="status">
    <div class="flex-grow-1">
        <strong>{{greeting}}</strong> {{message}}
    </div>
    {{#ctas}}
        <a class="alert-link" href="{{url}}">{{label}}</a>
    {{/ctas}}
</div>
