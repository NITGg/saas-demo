{{!
    @template theme_nit/core/signup_form_layout

    NIT override of core/signup_form_layout — the T1 "Create your account" screen.
    Renders inside theme_nit/core/login_layout (signup.php uses the 'login'
    pagelayout), so it inherits the split screen + dark brand panel.

    The stepper is a PROGRESSIVE ENHANCEMENT over Moodle's real signup mform: the
    JS below groups the form's actual <fieldset>s into steps with Back/Next and a
    progress header, and only advances when the current step passes client validation.
    Nothing about the form is rebuilt — all fields, names, ids, the security
    question / recaptcha and the real submit are Moodle's own.
}}
<style>
  .nit-auth .signupform .invalid-feedback,
  .nit-auth .signupform .form-control-feedback {
    color: #e03131 !important;
    font-size: 13px !important;
    font-weight: 500 !important;
    margin-top: 5px !important;
    display: block !important;
  }
  .nit-auth .signupform input.is-invalid,
  .nit-auth .signupform select.is-invalid {
    border-color: #e03131 !important;
    box-shadow: 0 0 0 3px rgba(224, 49, 49, 0.15) !important;
  }
  .nit-field-hint {
    font-size: 12px;
    color: var(--a-muted, #6E7781);
    margin-top: 4px;
  }
</style>

<div class="signupform">
    <h1>{{#str}}signupcreatetitle, theme_nit{{/str}}</h1>
    <p class="text-muted mb-4">{{#str}}signupsubtitle, theme_nit{{/str}}</p>

    <ol class="nit-auth-steps" id="nit-signup-steps" hidden></ol>
    {{{formhtml}}}
    <div class="signup-haveaccount text-center" style="margin-top:16px;">
        <span class="text-muted me-1">{{#str}} alreadyhaveaccount, theme_nit {{/str}}</span>
        <a href="{{config.wwwroot}}/login/index.php">{{#str}} logintoaccount, theme_nit {{/str}}</a>
    </div>
</div>
<script>
(function () {
    'use strict';
    try {
        var root = document.querySelector('.nit-auth .signupform');
        var form = root && root.querySelector('form');
        if (!form) { return; }

        var isar = (document.documentElement.getAttribute('lang') || '').indexOf('ar') === 0;
        var T = {
            next:        isar ? 'التالي'                   : 'Next',
            back:        isar ? 'السابق'                   : 'Back',
            create:      isar ? 'إنشاء الحساب'             : 'Create account',
            creating:    isar ? 'جارٍ إنشاء الحساب...'     : 'Creating account...',
            account:     isar ? 'الحساب'                   : 'Account',
            details:     isar ? 'بياناتك'                  : 'Your details',
            finish:      isar ? 'إنهاء'                    : 'Finish',
            parentHint:  isar ? 'اختياري: اكتب رقم ولي أمرك لكي يتمكن من متابعة درجاتك ونشاطك.' : 'Optional: Enter your parent\'s phone number to let them follow your progress.',
            reqErr:      isar ? 'هذا الحقل مطلوب'          : 'This field is required',
            userErr:     isar ? 'اسم المستخدم يجب أن يكون بحروف صغيرة فقط وبدون مسافات' : 'Username must be lowercase letters only with no spaces',
            emailErr:    isar ? 'يرجى إدخال بريد إلكتروني صحيح' : 'Please enter a valid email address',
            emailMatch:  isar ? 'البريد الإلكتروني غير متطابق' : 'Email addresses do not match',
            phoneErr:    isar ? 'يرجى إدخال رقم هاتف صحيح (أرقام فقط)' : 'Please enter a valid phone number (digits only)'
        };

        // Hint under the parent phone field: it is what the parent types on the
        // parent dashboard (local/parent/index.php) to follow this student.
        var parentPhoneField = form.querySelector('[name="profile_field_parentphone"]');
        if (parentPhoneField) {
            var hint = document.createElement('div');
            hint.className = 'nit-field-hint';
            hint.textContent = T.parentHint;
            parentPhoneField.parentNode.appendChild(hint);
        }

        // Restrict all phone fields to valid phone characters only (reject strings).
        form.querySelectorAll('input[type="tel"], input[name*="phone"]').forEach(function (inp) {
            inp.setAttribute('pattern', '^[+]?[0-9\\s\\-()]{7,25}$');
            inp.setAttribute('inputmode', 'tel');
            inp.addEventListener('input', function () {
                var cleaned = this.value.replace(/[^0-9+\s\-()]/g, '');
                if (this.value !== cleaned) {
                    this.value = cleaned;
                }
            });
        });

        // The real submit + its row — we drive it and hide the native row.
        var submitBtn = form.querySelector('#id_submitbutton') || form.querySelector('[type="submit"]');
        var submitRow = submitBtn && (submitBtn.closest('.fitem') || submitBtn.closest('.form-group') || submitBtn.closest('.row'));

        // Partition form rows into up to three steps.
        var ACCOUNT = ['username', 'password', 'email', 'email2'];
        function fieldName(row) {
            var el = row.querySelector('input:not([type="hidden"]), select, textarea');
            return el ? (el.name || '').replace(/\[.*$/, '') : '';
        }
        function stepOf(name) {
            if (ACCOUNT.indexOf(name) >= 0) { return 0; }
            if (/recaptcha|policyagreed|agree|security/i.test(name)) { return 2; }
            return 1;
        }

        var rows = Array.prototype.slice.call(form.querySelectorAll('.fitem, .form-group.row'))
            .filter(function (r) {
                if (submitRow && (r === submitRow || submitRow.contains(r) || r.contains(submitRow))) { return false; }
                return r.querySelector('input, select, textarea') || r.querySelector('.form-control-static, .felement');
            });

        if (rows.length < 3) { return; } // Too small to step.

        var buckets = [[], [], []];
        rows.forEach(function (r) { buckets[stepOf(fieldName(r))].push(r); });
        var steps = buckets.filter(function (b) { return b.length; });
        if (steps.length < 2) { return; }

        var labels = [];
        if (buckets[0].length) { labels.push(T.account); }
        if (buckets[1].length) { labels.push(T.details); }
        if (buckets[2].length) { labels.push(T.finish); }

        if (submitRow) { submitRow.style.display = 'none'; }

        // Wrap each step's rows in its own container so we can show one at a time.
        var containers = steps.map(function (bucket) {
            var box = document.createElement('div');
            box.className = 'nit-signup-step';
            bucket[0].parentNode.insertBefore(box, bucket[0]);
            bucket.forEach(function (r) { box.appendChild(r); });
            return box;
        });

        // Progress header.
        var head = document.getElementById('nit-signup-steps');
        head.innerHTML = '';
        labels.forEach(function (label, i) {
            var li = document.createElement('li');
            var sp = document.createElement('span'); sp.textContent = String(i + 1);
            var em = document.createElement('em'); em.style.fontStyle = 'normal'; em.textContent = label;
            li.appendChild(sp); li.appendChild(em);
            head.appendChild(li);
        });
        head.hidden = false;

        // Back / Next nav row.
        var nav = document.createElement('div');
        nav.className = 'nit-auth-nav';
        var back = document.createElement('button');
        back.type = 'button'; back.className = 'btn btn-back'; back.textContent = T.back;
        var next = document.createElement('button');
        next.type = 'button'; next.className = 'btn btn-next'; next.textContent = T.next;
        nav.appendChild(back); nav.appendChild(next);
        (submitRow ? submitRow.parentNode : form).appendChild(nav);

        var cur = 0;
        var LAST = containers.length - 1;

        function render() {
            containers.forEach(function (c, i) { c.style.display = (i === cur) ? '' : 'none'; });
            Array.prototype.forEach.call(head.children, function (li, i) {
                li.classList.toggle('on', i <= cur);
            });
            back.style.display = (cur === 0) ? 'none' : '';
            next.textContent = (cur === LAST) ? T.create : T.next;
            next.disabled = false;
        }

        // Comprehensive step validator that checks both HTML5 and Moodle requirements.
        function validStep(i) {
            var els = containers[i].querySelectorAll('input, select, textarea');
            var ok = true;
            var firstInvalid = null;

            for (var k = 0; k < els.length; k++) {
                var el = els[k];
                if (el.type === 'hidden' || el.disabled) { continue; }

                var name = (el.name || '').replace(/\[.*$/, '');
                var val = (el.value || '').trim();
                var row = el.closest('.fitem, .form-group') || el.parentElement;
                var errDiv = row.querySelector('.invalid-feedback, [id^="id_error_"], .error');

                var clearErr = function () {
                    el.classList.remove('is-invalid');
                    if (errDiv) {
                        errDiv.textContent = '';
                        errDiv.style.display = 'none';
                    }
                };

                var setErr = function (msg) {
                    ok = false;
                    el.classList.add('is-invalid');
                    if (errDiv) {
                        errDiv.textContent = msg;
                        errDiv.style.display = 'block';
                    }
                    if (!firstInvalid) { firstInvalid = el; }
                };

                clearErr();

                // Check required / aria-required fields.
                var isReq = el.required || el.getAttribute('aria-required') === 'true';
                if (isReq && val === '') {
                    setErr(T.reqErr);
                    continue;
                }

                // Username rules: lowercase only, no spaces.
                if (name === 'username' && val !== '') {
                    if (val !== val.toLowerCase() || /\s/.test(val)) {
                        setErr(T.userErr);
                        continue;
                    }
                }

                // Email format.
                if ((name === 'email' || el.type === 'email') && val !== '') {
                    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) {
                        setErr(T.emailErr);
                        continue;
                    }
                }

                // Email confirmation match.
                if (name === 'email2' && val !== '') {
                    var origEmail = form.querySelector('[name="email"]');
                    if (origEmail && val.toLowerCase() !== (origEmail.value || '').trim().toLowerCase()) {
                        setErr(T.emailMatch);
                        continue;
                    }
                }

                // Phone format.
                if ((name.indexOf('phone') >= 0 || el.type === 'tel') && val !== '') {
                    var digits = val.replace(/\D/g, '');
                    if (!/^[+]?[0-9\s\-()]{7,25}$/.test(val) || digits.length < 7) {
                        setErr(T.phoneErr);
                        continue;
                    }
                }

                if (el.willValidate && !el.checkValidity()) {
                    setErr(el.validationMessage || T.reqErr);
                }
            }

            if (!ok && firstInvalid) {
                firstInvalid.focus();
            }
            return ok;
        }

        next.addEventListener('click', function () {
            if (!validStep(cur)) { return; }

            if (cur === LAST) {
                // Before final submit, re-validate all steps to be 100% sure.
                for (var s = 0; s < containers.length; s++) {
                    if (!validStep(s)) {
                        cur = s;
                        render();
                        return;
                    }
                }

                next.disabled = true;
                next.textContent = T.creating;

                // Ensure all form elements are visible to the browser right before submit
                // so constraint validation doesn't fail on hidden fields.
                containers.forEach(function (c) { c.style.display = ''; });

                if (submitBtn) {
                    submitBtn.click();
                } else {
                    form.submit();
                }
                return;
            }

            cur++;
            render();
            if (root.scrollIntoView) {
                root.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        });

        back.addEventListener('click', function () {
            if (cur > 0) {
                cur--;
                render();
            }
        });

        // If Moodle re-rendered with server-side validation error, open the first step holding it.
        var errsel = '.is-invalid, .has-danger, [id^="id_error_"], .error, .invalid-feedback';
        for (var s = 0; s < containers.length; s++) {
            var errEls = containers[s].querySelectorAll(errsel);
            var hasErr = false;
            for (var k = 0; k < errEls.length; k++) {
                var el = errEls[k];
                if (el.classList.contains('is-invalid') ||
                    (el.textContent && el.textContent.trim() !== '') ||
                    (el.style.display && el.style.display !== 'none')) {
                    hasErr = true;
                    break;
                }
            }
            if (hasErr) {
                cur = s;
                break;
            }
        }

        render();
    } catch (e) {
        // Fallback: any failure leaves Moodle's full signup form intact.
    }
})();
</script>
