{{!
    @template theme_nit/core/loginform

    NIT override of core/loginform — Bassthalk-style sign-in card. Keeps every
    Moodle mechanism (field names/ids, logintoken, forgot/signup urls, identity
    providers, toggle-password JS, Submit.init). We log in by email (not phone),
    and keep the "parent account" and "guest" buttons. Rendered inside
    theme_nit/core/login_layout.
}}
<div class="loginform">
    <h1>أهلا تاني! جاهز للمذاكرة؟</h1>
    <p class="login-subtitle">ادخل علي حسابك بإدخال البريد الإلكتروني و كلمة المرور المسجل بهم من قبل</p>

    {{#maintenance}}
        <div class="alert alert-danger login-maintenance">{{{maintenance}}}</div>
    {{/maintenance}}
    {{#error}}
        <div class="alert alert-danger" id="loginerrormessage" role="alert">
            {{#errortitle}}<strong class="d-block mb-1">{{errortitle}}</strong>{{/errortitle}}
            {{error}}
        </div>
    {{/error}}
    {{#info}}
        <div class="alert alert-info" id="logininfomessage" role="status">{{info}}</div>
    {{/info}}

    {{#hasidentityproviders}}
        <div class="login-identityproviders">
            {{#identityproviders}}
                <a class="btn login-identityprovider-btn" href="{{url}}">
                    {{#iconurl}}<img src="{{iconurl}}" alt="" width="20" height="20"/>{{/iconurl}}
                    {{#str}}loginwith, core, {{name}}{{/str}}
                </a>
            {{/identityproviders}}
        </div>
        {{#showloginform}}<div class="login-separator">{{#str}}loginseparatoror{{/str}}</div>{{/showloginform}}
    {{/hasidentityproviders}}

    {{#showloginform}}
        <form class="login-form" action="{{loginurl}}" method="post" id="login">
            <input id="anchor" type="hidden" name="anchor" value="">
            <script>document.getElementById('anchor').value = location.hash;</script>
            <input type="hidden" name="logintoken" value="{{logintoken}}">

            <div class="login-field login-form-username">
                <label for="username" class="sr-only visually-hidden">البريد الإلكتروني</label>
                <span class="login-field-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.5 7 8.5 6 8.5-6"/></svg>
                </span>
                <input type="text" name="username" id="username" class="form-control" value="{{username}}" {{!
                    !}}placeholder="البريد الإلكتروني" autocomplete="username">
            </div>

            <div class="login-field login-form-password nit-pw-wrap">
                <label for="password" class="sr-only visually-hidden">كلمة السر</label>
                <span class="login-field-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2.2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                </span>
                <input type="password" name="password" id="password" value="" class="form-control" {{!
                    !}}placeholder="كلمة السر" autocomplete="current-password">
                <button type="button" class="nit-pw-eye" aria-label="{{#str}}showpassword, theme_nit{{/str}}" {{!
                    !}}onclick="var i=document.getElementById('password'); var on=i.type==='password'; i.type=on?'text':'password'; this.setAttribute('aria-pressed', on); this.classList.toggle('on', on);">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
            </div>

            <div class="login-forgot">هل نسيت كلمة السر؟ <a href="{{forgotpasswordurl}}">اضغط هنا</a></div>

            {{#recaptcha}}<div class="login-form-recaptcha mb-3">{{{recaptcha}}}</div>{{/recaptcha}}
            <div class="login-form-submit">
                <button class="btn btn-primary" type="submit" id="loginbtn">تسجيل الدخول</button>
            </div>
        </form>
    {{/showloginform}}

    <div class="login-signup">لا يوجد لديك حساب؟ <a href="{{config.wwwroot}}/local/academy/register.php">انشئ حسابك الآن !</a></div>

    <div class="login-aux">
        {{! Kept by request: parent account. Guest login removed (same purpose as "back to home"). }}
        <a class="btn-secondary-auth" href="{{config.wwwroot}}/local/parent/signup.php">إنشاء حساب ولي أمر</a>
    </div>

    {{#languagemenu}}
        <div class="login-languagemenu d-flex justify-content-center my-4">{{>core/action_menu}}</div>
    {{/languagemenu}}
</div>

{{#js}}
    {{^error}}
        {{#autofocusform}}
            require(['core_form/events'], function(FormEvent) {
                function autoFocus() {
                    const userNameField = document.getElementById('username');
                    const passwordField = document.getElementById('password');
                    if (userNameField && userNameField.value.length == 0) { userNameField.focus(); }
                    else if (passwordField) { passwordField.focus(); }
                }
                autoFocus();
                window.addEventListener(FormEvent.eventTypes.fieldStructureChanged, autoFocus);
            });
        {{/autofocusform}}
    {{/error}}
    require(['core/pending'], function(Pending) {
        const errorMessageDiv = document.getElementById('loginerrormessage');
        const infoMessageDiv = document.getElementById('logininfomessage');
        const errorMessage = errorMessageDiv?.textContent.trim();
        const infoMessage = infoMessageDiv?.textContent.trim();
        if (errorMessage || infoMessage) {
            const pendingJS = new Pending('login-move-focus');
            const usernameField = document.getElementById('username');
            setTimeout(function() {
                if (errorMessage && usernameField) { usernameField.focus(); }
                if (errorMessage) { errorMessageDiv.innerHTML += "&nbsp;"; }
                if (infoMessage) { infoMessageDiv.innerHTML += "&nbsp;"; }
                pendingJS.resolve();
            }, 500);
        }
    });
    require(['core_form/submit'], function(Submit) {
        Submit.init("loginbtn");
    });
{{/js}}
