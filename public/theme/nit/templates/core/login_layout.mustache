{{!
    @template theme_nit/core/login_layout

    NIT override of core/login_layout — the T1 "Academy app" login/signup screen:
    the form sits in a left panel, a dark brand panel on the right (hidden on
    mobile). Colours resolve from the Brand Colors palette (--nit-brand-*); the
    right panel uses the hero image when one is set (logincompact fallback). The
    form itself is core/loginform (also overridden by theme_nit).
}}
<style>
  .nit-auth { --a-ink:#16191D; --a-bg:#FFFFFF; --a-muted:#6E7781; --a-border:#EDEDE9; --a-accent: var(--nit-brand-primary); --a-on-accent: var(--nit-brand-on-primary, #fff);
    min-height:100vh; display:flex; background:var(--a-bg); color:var(--a-ink);
    font-family:'Manrope','IBM Plex Sans Arabic',system-ui,sans-serif; }
  .nit-auth-form { flex:1 1 52%; display:flex; flex-direction:column; padding:clamp(24px,4vw,56px); }
  .nit-auth-inner { width:100%; max-width:420px; margin:auto; }
  .nit-auth-brand { display:flex; align-items:center; gap:11px; text-decoration:none; color:inherit; }
  .nit-auth-brand .mark { width:30px; height:30px; border-radius:9px; background:linear-gradient(145deg, var(--a-accent), color-mix(in srgb, var(--a-accent) 60%, #fff)); box-shadow:0 6px 16px color-mix(in srgb, var(--a-accent) 30%, transparent); }
  .nit-auth-brand .name { font-size:18px; font-weight:500; letter-spacing:-0.02em; }
  .nit-auth-side { flex:0 0 48%; position:relative; overflow:hidden; background:#07090D; }
  .nit-auth-side .bg { position:absolute; inset:0; background:radial-gradient(120% 90% at 80% 10%, color-mix(in srgb, var(--a-accent) 40%, #07090D), #07090D 70%); }
  .nit-auth-side .art { position:absolute; inset:0; background-size:cover; background-position:center; opacity:.5; mix-blend-mode:luminosity; }
  .nit-auth-side .quote { position:absolute; inset-inline-start:0; bottom:0; padding:clamp(28px,4vw,56px); color:#fff; }
  .nit-auth-side .quote h2 { font-weight:250; font-size:clamp(24px,2.4vw,34px); letter-spacing:-0.03em; margin:0; line-height:1.2; }
  .nit-auth-side .quote p { margin:12px 0 0; color:#9CA3AA; font-size:14px; line-height:1.7; max-width:360px; }
  @media (max-width: 991px){ .nit-auth-side{ display:none; } .nit-auth-form{ flex-basis:100%; } }

  /* Form styling (core/loginform markup, restyled) */
  .nit-auth .loginform h1{ font-size:clamp(34px,4vw,44px); font-weight:250; letter-spacing:-0.03em; margin:22px 0 0; }
  .nit-auth .loginform > p.text-muted{ color:var(--a-muted)!important; font-size:15px; margin:8px 0 26px; }
  .nit-auth .login-form-username, .nit-auth .login-form-password{ margin-bottom:16px; }
  .nit-auth .form-label{ font-size:13px; color:var(--a-muted); margin-bottom:6px; font-weight:500; }
  .nit-auth .form-control{ width:100%; border:1px solid var(--a-border); border-radius:12px; padding:13px 14px; font-size:15px; background:var(--a-bg); color:var(--a-ink); }
  .nit-auth .form-control:focus{ outline:none; border-color:var(--a-accent); box-shadow:0 0 0 3px color-mix(in srgb, var(--a-accent) 18%, transparent); }
  .nit-auth .login-form-password{ position:relative; }
  .nit-auth .login-form-password label{ display:flex; justify-content:space-between; align-items:baseline; }
  .nit-auth .login-form-password label a{ color:var(--a-accent); font-size:12px; font-weight:600; text-decoration:none; }
  .nit-auth [data-passwordunmask], .nit-auth .toggle-sensitive, .nit-auth button.btn-link.position-absolute{ color:var(--a-muted); }
  .nit-auth .login-form-submit .btn, .nit-auth #loginbtn{ width:100%; background:var(--a-ink); border:0; color:#fff; padding:15px; border-radius:12px; font-weight:600; font-size:15px; }
  .nit-auth .login-form-submit .btn:hover, .nit-auth #loginbtn:hover{ filter:brightness(1.12); }
  .nit-auth .login-identityprovider-btn{ width:100%; display:flex; align-items:center; justify-content:center; gap:10px; border:1px solid var(--a-border)!important; border-radius:12px!important; padding:13px!important; font-weight:600!important; color:var(--a-ink)!important; background:var(--a-bg)!important; margin-bottom:10px!important; }
  .nit-auth .login-identityprovider-btn:hover{ border-color:var(--a-accent)!important; }
  .nit-auth .login-separator{ display:flex; align-items:center; text-align:center; color:var(--a-muted); font-size:13px; margin:22px 0; }
  .nit-auth .login-separator::before, .nit-auth .login-separator::after{ content:""; flex:1; height:1px; background:var(--a-border); }
  .nit-auth .login-separator::before{ margin-inline-end:14px; } .nit-auth .login-separator::after{ margin-inline-start:14px; }
  .nit-auth .login-keepsignedin{ display:flex; align-items:center; gap:8px; font-size:13px; color:var(--a-muted); margin-bottom:16px; }
  .nit-auth .loginform .text-center a, .nit-auth .loginform a[href*="signup"]{ color:var(--a-accent); font-weight:600; text-decoration:none; }
  .nit-auth .login-cookiesnotice{ margin-top:22px; }
  .nit-auth .login-cookiesnotice .btn-link{ color:var(--a-muted); font-size:12px; }

  /* Signup ("Create your account") */
  .nit-auth .signupform h1{ font-size:clamp(30px,3.4vw,40px); font-weight:250; letter-spacing:-0.03em; margin:18px 0 0; }
  .nit-auth-steps{ list-style:none; display:flex; align-items:center; gap:10px; padding:0; margin:0; flex-wrap:wrap; font-size:13px; color:var(--a-muted); }
  .nit-auth-steps li{ display:flex; align-items:center; gap:7px; }
  .nit-auth-steps li span{ width:22px; height:22px; border-radius:50%; display:grid; place-items:center; font-size:12px; font-weight:700; border:1px solid var(--a-border); color:var(--a-muted); }
  .nit-auth-steps li.on{ color:var(--a-ink); font-weight:600; }
  .nit-auth-steps li.on span{ background:var(--a-accent); color:var(--a-on-accent); border-color:var(--a-accent); }
  .nit-auth-steps li:not(:last-child)::after{ content:""; width:26px; height:1px; background:var(--a-border); }
  .nit-auth .signupform .form-control, .nit-auth .signupform input[type=text], .nit-auth .signupform input[type=email], .nit-auth .signupform input[type=password]{ width:100%; border:1px solid var(--a-border); border-radius:12px; padding:13px 14px; font-size:15px; }
  .nit-auth .signupform .col-form-label, .nit-auth .signupform label{ font-size:13px; color:var(--a-muted); font-weight:500; }
  .nit-auth .signupform .btn-primary, .nit-auth .signupform #id_submitbutton{ width:100%; background:var(--a-ink); border:0; color:#fff; padding:15px; border-radius:12px; font-weight:600; }
  .nit-auth .signupform .btn-primary:hover{ filter:brightness(1.12); }
  .nit-auth .signupform .mform .fitem{ margin-bottom:14px; }
  .nit-auth .signupform fieldset{ border:0; padding:0; margin:0; }
  .nit-auth .signupform .fcontainer{ display:block; }
</style>
<div class="nit-auth">
  <div class="nit-auth-form">
    <a class="nit-auth-brand" href="/">
      <span class="mark"></span>
      <span class="name">{{sitename}}</span>
    </a>
    <div class="nit-auth-inner">
      {{{ output.main_content }}}
    </div>
  </div>
  <aside class="nit-auth-side">
    <div class="bg"></div>
    <div class="art" id="nit-auth-art"></div>
    <div class="quote">
      <h2>{{#str}}welcometosite, theme_nit, {{sitename}}{{/str}}</h2>
      <p>{{#str}}authsidetagline, theme_nit{{/str}}</p>
    </div>
  </aside>
</div>
