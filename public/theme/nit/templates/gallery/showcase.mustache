{{!
    @template theme_nit/gallery/showcase

    NIT design-system component gallery, organised into tabs.

    Context variables required for this template:
    * sesskey - session key for the editor forms
    * actionurl - POST target for the editor forms
    * colourgroups - array of { name, colours: [ { key, label, configname, value, default, isdefault } ] }
    * fonts - array of { input, label, family, sample, rtl, hasfont, filename }
    * stats - array of { label, value, trend, up }

    Example context (json):
    {
        "sesskey": "abc123",
        "actionurl": "/theme/nit/gallery.php",
        "colourgroups": [
            { "name": "Brand", "colours": [
                { "key": "primary", "label": "Primary", "configname": "theme_nit | colour_primary",
                  "value": "#2a50c8", "default": "#2a50c8", "isdefault": true }
            ] }
        ],
        "fonts": [
            { "input": "fontfile_en", "label": "English font", "family": "NIT Site Font EN",
              "sample": "The quick brown fox", "rtl": false, "hasfont": true, "filename": "font-en.ttf" }
        ],
        "stats": [ { "label": "Learners", "value": "1,284", "trend": "+12%", "up": true } ]
    }
}}
<div class="nit-gallery pb-5">

    <ul class="nav nav-tabs mt-4" id="nit-gallery-tabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="nit-tab-brand-btn" data-bs-toggle="tab"
                    data-bs-target="#nit-tab-brand" type="button" role="tab"
                    aria-controls="nit-tab-brand" aria-selected="true">
                {{#str}}tab_brandcolours, theme_nit{{/str}}
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="nit-tab-catstyles-btn" data-bs-toggle="tab"
                    data-bs-target="#nit-tab-catstyles" type="button" role="tab"
                    aria-controls="nit-tab-catstyles" aria-selected="false">
                {{#str}}tab_categorystyles, theme_nit{{/str}}
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="nit-tab-fonts-btn" data-bs-toggle="tab"
                    data-bs-target="#nit-tab-fonts" type="button" role="tab"
                    aria-controls="nit-tab-fonts" aria-selected="false">
                {{#str}}tab_fonts, theme_nit{{/str}}
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="nit-tab-components-btn" data-bs-toggle="tab"
                    data-bs-target="#nit-tab-components" type="button" role="tab"
                    aria-controls="nit-tab-components" aria-selected="false">
                {{#str}}tab_components, theme_nit{{/str}}
            </button>
        </li>
    </ul>

    <div class="tab-content pt-4" id="nit-gallery-tabs-content">

        {{! ---------------------------------------------------------------- }}
        {{! Brand Colors tab — the new semantic palette (3 groups × 13 roles) }}
        {{! ---------------------------------------------------------------- }}
        <div class="tab-pane fade show active" id="nit-tab-brand" role="tabpanel"
             aria-labelledby="nit-tab-brand-btn" tabindex="0">
            <h3>Brand Colors</h3>
            <p class="text-muted">{{#str}}brandcolours_desc, theme_nit{{/str}}</p>
            {{! Each group is its own form so Save / Reset act on that group only. }}
            {{#brandgroups}}
            <form method="post" action="{{actionurl}}" class="nit-colour-editor mb-4">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="brandgroup" value="{{groupkey}}">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-4 mb-2">
                    <h4 class="h6 text-uppercase text-muted mb-0">{{name}}</h4>
                    <div class="d-flex gap-2">
                        <button type="submit" name="savebrand" value="1" class="btn btn-sm btn-primary">
                            {{#str}}savebrandcolours, theme_nit{{/str}}
                        </button>
                        <button type="submit" name="resetbrand" value="1" class="btn btn-sm btn-outline-secondary">
                            {{#str}}resetbrandcolours, theme_nit{{/str}}
                        </button>
                    </div>
                </div>
                <div class="nit-colour-grid">
                    {{#roles}}
                        <div class="nit-colour-row" data-nit-colour>
                            <div class="nit-colour-meta">
                                <label class="nit-colour-name" for="nit-brand-{{key}}">{{label}}</label>
                                <code class="nit-colour-config">{{cssvar}}</code>
                                <span class="nit-colour-usage">
                                    {{#usage}}<span class="nit-colour-usage-item">{{label}}</span>{{/usage}}
                                </span>
                            </div>
                            <div class="nit-colour-controls">
                                <input type="color" id="nit-brand-{{key}}" name="brandcolour_{{key}}" value="{{value}}"
                                       class="nit-colour-swatch" aria-label="{{label}}">
                                <input type="text" name="brandcolour_{{key}}_hex" value="{{value}}"
                                       class="form-control nit-colour-hex" aria-label="{{label}} hex value"
                                       pattern="#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})" maxlength="7">
                                <span class="nit-colour-default">Default: {{default}}</span>
                            </div>
                        </div>
                    {{/roles}}
                </div>
            </form>
            {{/brandgroups}}
        </div>

        {{! ---------------------------------------------------------------- }}
        {{! Category styles tab — assign a brand group to each category page  }}
        {{! ---------------------------------------------------------------- }}
        <div class="tab-pane fade" id="nit-tab-catstyles" role="tabpanel"
             aria-labelledby="nit-tab-catstyles-btn" tabindex="0">
            <h3>{{#str}}tab_categorystyles, theme_nit{{/str}}</h3>
            <p class="text-muted">{{#str}}categorystyles_desc, theme_nit{{/str}}</p>
            {{#hascategorygroups}}
            <form method="post" action="{{actionurl}}" class="nit-catstyles-editor mb-4">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <div class="table-responsive">
                    <table class="table table-sm align-middle nit-catstyles-table">
                        <thead>
                            <tr>
                                <th scope="col">{{#str}}categorystyles_col_category, theme_nit{{/str}}</th>
                                <th scope="col" style="width: 12rem;">{{#str}}categorystyles_col_group, theme_nit{{/str}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#categorygroups}}
                            <tr>
                                <td>{{name}}</td>
                                <td>
                                    <select class="form-select form-select-sm" name="catgroup[{{id}}]" aria-label="{{name}}">
                                        {{#options}}
                                        <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                        {{/options}}
                                    </select>
                                </td>
                            </tr>
                            {{/categorygroups}}
                        </tbody>
                    </table>
                </div>
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" name="savecatgroups" value="1" class="btn btn-primary">
                        {{#str}}savecategorygroups, theme_nit{{/str}}
                    </button>
                </div>
            </form>
            {{/hascategorygroups}}
            {{^hascategorygroups}}
            <p class="text-muted fst-italic">{{#str}}categorystyles_none, theme_nit{{/str}}</p>
            {{/hascategorygroups}}
        </div>

        {{! ---------------------------------------------------------------- }}
        {{! Fonts tab                                                        }}
        {{! ---------------------------------------------------------------- }}
        <div class="tab-pane fade" id="nit-tab-fonts" role="tabpanel"
             aria-labelledby="nit-tab-fonts-btn" tabindex="0">
            <h3>{{#str}}fonts, theme_nit{{/str}}</h3>
            <p class="text-muted">{{#str}}fonts_desc, theme_nit{{/str}}</p>
            <form method="post" action="{{actionurl}}" enctype="multipart/form-data" class="nit-fonts-editor mb-4">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                {{#fonts}}
                    <div class="nit-font-slot mb-4 pb-3 border-bottom">
                        <h4 class="h6 mb-2">{{label}}</h4>
                        {{#hasfont}}
                            <p class="mb-2">
                                <span class="badge text-bg-success">{{#str}}fontactive, theme_nit{{/str}}</span>
                                <code>{{filename}}</code>
                            </p>
                        {{/hasfont}}
                        {{^hasfont}}
                            <p class="text-muted mb-2">{{#str}}fontnone, theme_nit{{/str}}</p>
                        {{/hasfont}}
                        <input type="file" name="{{input}}" accept=".ttf,.otf,font/ttf,font/otf"
                               class="form-control nit-font-input" aria-label="{{label}}">
                        <p class="nit-font-preview mt-3 mb-0 fs-4" style="font-family: '{{family}}';"
                           {{#rtl}}dir="rtl"{{/rtl}}>{{sample}}</p>
                    </div>
                {{/fonts}}
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" name="savefonts" value="1" class="btn btn-primary">
                        {{#str}}savefonts, theme_nit{{/str}}
                    </button>
                    <button type="submit" name="resetfonts" value="1" class="btn btn-outline-secondary">
                        {{#str}}resetfonts, theme_nit{{/str}}
                    </button>
                </div>
            </form>
        </div>

        {{! ---------------------------------------------------------------- }}
        {{! Components tab                                                   }}
        {{! ---------------------------------------------------------------- }}
        <div class="tab-pane fade" id="nit-tab-components" role="tabpanel"
             aria-labelledby="nit-tab-components-btn" tabindex="0">

            <h3>Buttons</h3>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <button type="button" class="btn btn-primary">Primary</button>
                <button type="button" class="btn btn-secondary">Secondary</button>
                <button type="button" class="btn btn-success">Success</button>
                <button type="button" class="btn btn-warning">Warning</button>
                <button type="button" class="btn btn-danger">Danger</button>
                <button type="button" class="btn btn-outline-primary">Outline</button>
                <button type="button" class="btn btn-primary" disabled>Disabled</button>
            </div>

            <h3 class="mt-4">Alerts</h3>
            <div class="alert alert-primary" role="alert">A primary alert.</div>
            <div class="alert alert-success" role="alert">A success alert.</div>
            <div class="alert alert-warning" role="alert">A warning alert.</div>
            <div class="alert alert-danger" role="alert">A danger alert.</div>

        </div>

    </div>
</div>
