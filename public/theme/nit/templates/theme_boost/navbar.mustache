{{!
    @template theme_boost/navbar

    NIT override of the Boost top navbar — Bassthalk-style floating pill (RTL),
    site-wide, two versions driven by body.notloggedin:

      * Visitor: logo, search pill, language menu, "تسجيل الدخول" + "حساب جديد".
      * Logged in: logo, search pill, gear menu (the site pages), language menu,
        edit-mode switch, notifications, user menu (avatar).

    Colours: every colour reads the Brand Colors "Bassthalk" group (g18) through
    `.nit-brand-18` — edit them on Appearance → NIT Design System → Bassthalk.

    Every Moodle control is the real one (mobileprimarynav, output.edit_switch,
    output.navbar_plugin_output, core/user_menu, output.navbar_language_menu).
    Search opens a dialog that posts to Moodle's /course/search.php.

    Context variables required for this template:
    * output - The core renderer for the page.
    * sitename - The name of the site.
    * config - wwwroot / homeurl.
    * usermenu - User menu context (from the primary output).
    * mobileprimarynav - Array of primary nav items ({text, url, isactive, haschildren, children}).
}}
<style id="nit-bassthalk-navbar">
  @import url('https://fonts.googleapis.com/css2?family=Almarai:wght@400;700;800&family=Tajawal:wght@400;500;700&display=swap');

  /* Derived shades, all from Bassthalk-group roles. */
  .nit-navbar, .nit-search-modal{
    --nb-pad: color-mix(in srgb, var(--nit-brand-navbariconcolor) 18%, transparent);
    --nb-pad-hover: color-mix(in srgb, var(--nit-brand-navbariconcolor) 30%, transparent);
    --nb-shadow: 0 18px 40px rgba(0,0,0,.16);
  }

  /* ===== Floating pill ===== */
  /* The pill is 80px tall (bassthalk); the bar no longer stretches it to $navbar-height. */
  .nit-navbar.nit-navbar{ height:auto!important; }
  @media (min-width:992px){ .nit-navbar .nit-navbar-inner{ height:80px; } }
  .nit-navbar.nit-navbar{ background:transparent!important; box-shadow:none!important; border:0!important;
    padding:16px clamp(8px,2.5vw,32px) 0!important; direction:rtl; font-family:'Almarai','Tajawal',sans-serif; }
  .nit-navbar .nit-navbar-inner{ position:relative; background:var(--nit-brand-navbarbackground1)!important; border-radius:9999px; max-width:none; width:100%;
    min-height:80px; padding-inline:clamp(14px,1.8vw,24px); gap:clamp(8px,1.2vw,16px); 
    box-shadow:0 20px 25px -5px rgba(0,0,0,.1), 0 8px 10px -6px rgba(0,0,0,.1); }

  /* scroll progress — inside the pill, clipped to its rounded bottom edge */
  .nit-navbar-progress{ position:absolute; inset:0; border-radius:inherit; overflow:hidden; pointer-events:none; z-index:0; }
  .nit-navbar-track{ position:absolute; left:0; right:0; bottom:0; height:4px; background:var(--nit-brand-bthprogresstrack);
    opacity:0; transform:translateY(-8px); transition:opacity .4s ease, transform .4s ease; }
  .nit-navbar-track.show{ opacity:1; transform:translateY(0); }
  .nit-navbar-fill{ position:absolute; top:0; bottom:0; left:0; width:0; background:var(--nit-brand-bthprogressfill); transition:background-color .3s ease; }
  .nit-navbar .nit-navbar-inner > *:not(.nit-navbar-progress){ position:relative; z-index:1; }

  /* brand (right) */
  .nit-navbar .nit-navbar-logo{ height:56px!important; width:auto!important; }
  .nit-navbar .nit-navbar-title{ display:none!important; }
  .nit-navbar .nit-navbar-mark{ background:var(--nit-brand-navbariconcolor); }

  /* search pill (next to the logo) */
  .nit-search-trigger{ display:inline-flex; align-items:center; gap:8px; height:38px; padding:8px 12px; border-radius:9999px;
    background:var(--nit-brand-bthsearchbg); border:1px solid var(--nit-brand-bthsearchbg); color:var(--nit-brand-textprimary);
    font-family:'Almarai',sans-serif; font-size:13px; font-weight:700; cursor:pointer; white-space:nowrap; flex:none; transition:background-color .2s ease; }
  .nit-search-trigger:hover{ background:color-mix(in srgb, var(--nit-brand-bthsearchbg) 90%, black); border-color:color-mix(in srgb, var(--nit-brand-bthsearchbg) 90%, black); color:var(--nit-brand-textprimary); }
  .nit-search-trigger:focus-visible{ outline:2px solid var(--nit-brand-navbariconcolor); outline-offset:2px; }
  .nit-search-trigger svg{ width:18px; height:18px; flex:none; }
  @media (max-width:767px){ .nit-search-trigger{ width:40px; height:40px; padding:0; justify-content:center; } .nit-search-trigger span{ display:none; } }

  /* right cluster */
  /* The cluster sits at the far (left) end of the pill, like bassthalk: in RTL the
     inline-start margin is the right one, so auto there pushes it left. */
  .nit-navbar .nit-navbar-right{ gap:clamp(6px,.9vw,12px); margin-inline-start:auto!important; margin-inline-end:0!important; }
  .nit-navbar .nit-navbar-search, .nit-navbar .nit-navbar-links{ display:none!important; } /* replaced by the search dialog + gear menu */

  /* round icon pads: gear + bell */
  .nit-navbar .nit-navbar-gearbtn,
  .nit-navbar .popover-region-toggle{ width:40px; height:40px; border-radius:50%!important; background:var(--nb-pad)!important; border:0;
    display:flex!important; align-items:center; justify-content:center; padding:0!important; margin:0!important;
    color:var(--nit-brand-navbariconcolor)!important; cursor:pointer; }
  .nit-navbar .nit-navbar-gearbtn:hover, .nit-navbar .nit-navbar-gearbtn[aria-expanded="true"],
  .nit-navbar .popover-region-toggle:hover{ background:var(--nb-pad-hover)!important; color:var(--nit-brand-navbariconhovercolor)!important; }
  .nit-navbar .nit-navbar-gearbtn svg{ width:20px; height:20px; }
  .nit-navbar .nit-navbar-gearbtn.dropdown-toggle::after{ display:none!important; } /* the class wires Moodle's dropdown; no caret */
  .nit-navbar .popover-region-toggle .icon{ color:var(--nit-brand-navbariconcolor)!important; font-size:18px; width:auto; height:auto; margin:0!important; }
  .nit-navbar .popover-region-toggle::before, .nit-navbar .popover-region-toggle::after{ display:none!important; }
  .nit-navbar .popover-region .count-container{ background:var(--nit-brand-bthsignupbg); color:var(--nit-brand-bthsignuptext); font-weight:700;
    border:2px solid var(--nit-brand-navbarbackground1); }
  body.notloggedin .nit-navbar .nit-navbar-gear{ display:none!important; }

  /* language menu (everyone) — the ink does NOT change on hover */
  .nit-navbar .langmenu .dropdown-toggle,
  .nit-navbar .langmenu .dropdown-toggle:hover,
  .nit-navbar .langmenu .dropdown-toggle:focus{ display:inline-flex!important; align-items:center; gap:6px; height:40px!important; padding:0 14px!important;
    border-radius:9999px!important; border:0!important; color:var(--nit-brand-navbartitlecolor)!important;
    font-family:'Almarai',sans-serif; font-size:13px!important; }
  .nit-navbar .langmenu .dropdown-toggle{ background:var(--nb-pad); }
  .nit-navbar .langmenu .dropdown-toggle:hover, .nit-navbar .langmenu .dropdown-toggle:focus{ background:var(--nb-pad-hover); }
  .nit-navbar .langmenu .dropdown-toggle .icon{ color:inherit!important; margin:0; }

  /* edit-mode switch */
  .nit-navbar .editmode-switch-form label{ color:var(--nit-brand-navbartitlecolor)!important; font-family:'Almarai',sans-serif; font-size:13px; margin:0 0 0 6px!important; }
  .nit-navbar .form-switch .form-check-input{ background-color:color-mix(in srgb, var(--nit-brand-navbariconcolor) 35%, transparent); border-color:transparent; box-shadow:none; }
  .nit-navbar .form-switch .form-check-input:checked{ background-color:var(--nit-brand-checkcheckedbg); border-color:var(--nit-brand-checkcheckedborder); }

  /* user menu (avatar) */
  .nit-navbar .usermenu .dropdown-toggle,
  .nit-navbar .usermenu .dropdown-toggle:hover,
  .nit-navbar .usermenu .dropdown-toggle:focus{ display:inline-flex!important; align-items:center; gap:6px; height:44px!important; padding:3px 4px 3px 12px!important;
    border-radius:9999px!important; border:0!important; color:var(--nit-brand-navbartitlecolor)!important; }
  .nit-navbar .usermenu .dropdown-toggle{ background:var(--nb-pad)!important; }
  .nit-navbar .usermenu .dropdown-toggle:hover, .nit-navbar .usermenu .dropdown-toggle:focus{ background:var(--nb-pad-hover)!important; }
  .nit-navbar .usermenu .dropdown-toggle::after{ border-top-color:var(--nit-brand-navbariconcolor); margin:0; }
  .nit-navbar .usermenu .userinitials, .nit-navbar .usermenu .avatar img{ width:36px!important; height:36px!important; border-radius:50%;
    background:var(--nit-brand-surface); color:var(--nit-brand-navbarbackground1); font-weight:700; font-size:13px;
    border:2px solid color-mix(in srgb, var(--nit-brand-surface) 90%, transparent); }
  .nit-navbar .usermenu .login a{ color:var(--nit-brand-navbartitlecolor)!important; }

  /* every dropdown opens INSIDE the screen (the cluster sits at the left edge of the RTL pill) */
  .nit-navbar .nit-navbar-gear .dropdown-menu,
  .nit-navbar .usermenu .dropdown-menu,
  .nit-navbar .langmenu .dropdown-menu{ left:0!important; right:auto!important; top:calc(100% + 12px)!important; transform:none!important; margin:0!important;
    border:0!important; border-radius:12px; box-shadow:var(--nb-shadow); padding:8px; min-width:230px;
    background:var(--nit-brand-surface)!important; color:var(--nit-brand-textprimary)!important; }
  .nit-navbar .popover-region-container{ left:0!important; right:auto!important; top:calc(100% + 14px)!important;
    border:0!important; border-radius:12px; box-shadow:var(--nb-shadow); overflow:hidden; }
  html[dir="ltr"] .nit-navbar .dropdown-menu, html[dir="ltr"] .nit-navbar .popover-region-container{ direction:ltr; text-align:left; }
  html[dir="rtl"] .nit-navbar .dropdown-menu, html[dir="rtl"] .nit-navbar .popover-region-container{ direction:rtl; text-align:right; }
  /* menu items: the text keeps its colour on hover, only the row tints.
     Scoped by #usernavigation so it outranks the theme's admin-page rule
     `body:not(.pagelayout-frontpage):not(…) .dropdown-item { color … !important }`. */
  #usernavigation .dropdown-menu .dropdown-item{ border-radius:8px; color:var(--nit-brand-textprimary)!important; background:transparent; }
  #usernavigation .dropdown-menu .dropdown-item:hover,
  #usernavigation .dropdown-menu .dropdown-item:focus{ background:var(--nit-brand-hoverbackground)!important; color:var(--nit-brand-textprimary)!important; }
  #usernavigation .dropdown-menu .dropdown-item.active,
  #usernavigation .dropdown-menu .dropdown-item[aria-current="true"]{ background:var(--nit-brand-hoverbackground)!important; color:var(--nit-brand-textprimary)!important;
    font-weight:700; box-shadow:inset -3px 0 0 var(--nit-brand-accent); }
  .nit-navbar .nit-navbar-gearmenu .dropdown-header{ color:var(--nit-brand-textsecondary); font-size:12px; font-weight:700; padding:8px 12px 4px; }
  .nit-navbar .nit-navbar-gearmenu .nit-gear-child{ padding-inline-start:22px; }

  /* visitor buttons */
  .nit-navbar-guest{ display:none; align-items:center; gap:32px; }
  body.notloggedin .nit-navbar-guest{ display:inline-flex; }
  body.notloggedin .nit-navbar .usermenu-container,
  body.notloggedin .nit-navbar .nit-navbar-editswitch{ display:none!important; }
  .nit-navbar-btn{ height:40px; border-radius:6px; padding:8px 16px; font-family:'Almarai',sans-serif; font-size:14px; font-weight:700;
    display:inline-flex; align-items:center; justify-content:center; text-decoration:none!important; border:2px solid transparent; white-space:nowrap;
    transition:background-color .2s ease, border-color .2s ease; }
  /* !important: Moodle's global `a:not(.btn)…:hover` rule (very high specificity)
     would otherwise make these link-buttons transparent on hover. */
  .nit-navbar-btn.login{ background:var(--nit-brand-secondary)!important; border-color:var(--nit-brand-btnsecondaryborder)!important; color:var(--nit-brand-onsecondary)!important; }
  .nit-navbar-btn.login:hover, .nit-navbar-btn.login:focus{ background:var(--nit-brand-btnsecondaryhoverbg)!important; border-color:var(--nit-brand-btnsecondaryhoverborder)!important; color:var(--nit-brand-btnsecondaryhovertext)!important; }
  /* the sign-up button keeps its colours on hover */
  .nit-navbar-btn.signup, .nit-navbar-btn.signup:hover, .nit-navbar-btn.signup:focus{ background:var(--nit-brand-bthsignupbg)!important; border-color:var(--nit-brand-bthsignupbg)!important; color:var(--nit-brand-bthsignuptext)!important; filter:none!important; }

  @media (min-width:992px){ .nit-navbar .nit-navbar-inner{ padding-inline:40px; } }
  @media (max-width:991px){
    .nit-navbar .nit-navbar-inner{ border-radius:24px; min-height:64px; }
    .nit-navbar .nit-navbar-logo{ height:40px!important; }
    .nit-navbar-btn{ padding:6px 10px; font-size:13px; height:36px; }
    .nit-navbar-guest{ gap:10px; }
  }

  /* ===== Search dialog ===== */
  .nit-search-modal{ position:fixed; inset:0; z-index:1080; display:none; align-items:center; justify-content:center; direction:rtl; }
  .nit-search-modal.open{ display:flex; }
  .nit-search-backdrop{ position:absolute; inset:0; background:color-mix(in srgb, var(--nit-brand-background2) 72%, transparent);
    backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px); cursor:pointer; animation:nitFade .25s ease; }
  .nit-search-card{ position:relative; width:312px; max-width:calc(100vw - 32px); background:var(--nit-brand-background2); border-radius:6px; padding:20px;
    display:flex; flex-direction:column; gap:20px; font-family:'Almarai',sans-serif; animation:nitPop .25s ease; }
  .nit-search-title{ text-align:center; font-weight:700; font-size:20px; line-height:28px; color:var(--nit-brand-textprimary); padding:0 4px; white-space:nowrap; }
  .nit-search-group{ position:relative; }
  .nit-search-group input{ width:100%; height:51px; border:0; border-bottom:1px solid var(--nit-brand-textsecondary); border-radius:0; background:transparent;
    font-family:'Almarai',sans-serif; font-size:18px; color:var(--nit-brand-textprimary); padding:11px 11px 11px 6px; outline:none; transition:background-color .2s ease; }
  .nit-search-group input:focus{ background:var(--nit-brand-surface); }
  .nit-search-group label{ position:absolute; inset-inline-start:6px; top:50%; transform:translateY(-50%); display:flex; align-items:center; gap:6px;
    color:var(--nit-brand-textsecondary); font-size:18px; pointer-events:none; transition:all .2s ease; margin:0; }
  .nit-search-group label svg{ width:1em; height:1em; color:var(--nit-brand-bthfieldicon); }
  .nit-search-group input:focus ~ label, .nit-search-group input:not(:placeholder-shown) ~ label{ top:-8px; transform:none; font-size:13px; color:var(--nit-brand-bthfieldicon); }
  .nit-search-bar{ position:absolute; left:0; right:0; bottom:0; height:2px; background:var(--nit-brand-bthfieldicon); transform:scaleX(0); transition:transform .25s ease; }
  .nit-search-group input:focus ~ .nit-search-bar{ transform:scaleX(1); }
  .nit-search-submit{ width:100%; height:48px; border:1px solid var(--nit-brand-btnprimaryborder); border-radius:6px; background:var(--nit-brand-primary);
    color:var(--nit-brand-onprimary); font-family:'Almarai',sans-serif; font-size:20px; cursor:pointer; transition:background-color .2s ease; }
  .nit-search-submit:hover{ background:var(--nit-brand-btnprimaryhoverbg); border-color:var(--nit-brand-btnprimaryhoverborder); color:var(--nit-brand-btnprimaryhovertext); }
  @keyframes nitFade{ from{ opacity:0; } to{ opacity:1; } }
  @keyframes nitPop{ from{ opacity:0; transform:translateY(8px) scale(.98); } to{ opacity:1; transform:none; } }
</style>
<nav class="navbar fixed-top navbar-expand-lg nit-navbar nit-brand-18" aria-label="{{#str}}sitemenubar, admin{{/str}}">
    <div class="container-fluid nit-navbar-inner">
        {{! Scroll progress (clip layer keeps dropdowns un-clipped). }}
        <div class="nit-navbar-progress" aria-hidden="true">
            <div class="nit-navbar-track" id="nit-navbar-track"><div class="nit-navbar-fill" id="nit-navbar-fill"></div></div>
        </div>

        {{! Mobile: open Moodle's primary drawer (holds the nav on small screens). }}
        <button class="navbar-toggler aabtn d-lg-none px-1 my-1 border-0 nit-navbar-burger" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-primary">
            <span class="navbar-toggler-icon"></span>
            <span class="visually-hidden">{{#str}}sidepanel, core{{/str}}</span>
        </button>

        {{! Brand — compact logo (or a fallback mark). }}
        <a href="{{{ config.homeurl }}}" data-nit-edit="logo" class="navbar-brand nit-navbar-brand d-flex align-items-center m-0 p-0 aabtn">
            {{# output.should_display_navbar_logo }}
                <img src="{{output.get_compact_logo_url}}" class="nit-navbar-logo" alt="{{sitename}}">
            {{/ output.should_display_navbar_logo }}
            {{^ output.should_display_navbar_logo }}
                <span class="nit-navbar-mark" aria-hidden="true"></span>
            {{/ output.should_display_navbar_logo }}
            <span class="nit-navbar-title">{{{ sitename }}}</span>
        </a>

        {{! Search pill — opens the search dialog. }}
        <button type="button" class="nit-search-trigger" data-nit-search-open aria-label="{{#str}}bth_searchsite, theme_nit{{/str}}" aria-haspopup="dialog" aria-controls="nit-search-modal">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5A6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5S14 7.01 14 9.5S11.99 14 9.5 14"/></svg>
            <span>{{#str}}bth_searchsite, theme_nit{{/str}}</span>
        </button>

        <div id="usernavigation" class="nit-navbar-right navbar-nav ms-auto h-100 align-items-center">
            {{! Gear — the site pages, logged-in users: the links set on Site pages → Navbar menus, else Moodle's primary navigation. }}
            <div class="nit-navbar-gear dropdown d-none d-lg-flex align-items-center">
                <button type="button" class="nit-navbar-gearbtn dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false"
                        aria-label="{{#str}}navpagesmenu, theme_nit{{/str}}" title="{{#str}}navpagesmenu, theme_nit{{/str}}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                </button>
                <div class="dropdown-menu nit-navbar-gearmenu">
                    {{#output.nit_gear_items}}
                        {{^haschildren}}
                            <a class="dropdown-item{{#isactive}} active{{/isactive}}" href="{{{url}}}" {{#isactive}}aria-current="true"{{/isactive}}>{{{text}}}</a>
                        {{/haschildren}}
                        {{#haschildren}}
                            <h6 class="dropdown-header">{{{text}}}</h6>
                            {{#children}}
                                {{^divider}}
                                    <a class="dropdown-item nit-gear-child{{#isactive}} active{{/isactive}}" href="{{{url}}}" {{#isactive}}aria-current="true"{{/isactive}}>{{{text}}}</a>
                                {{/divider}}
                            {{/children}}
                        {{/haschildren}}
                    {{/output.nit_gear_items}}
                    {{! Owner "Upgrade" link ('' for non-owners). }}
                    {{{ output.nit_account_link }}}
                </div>
            </div>

            {{! Language menu (AR / EN) — visitors and logged-in users. }}
            <div class="nit-navbar-lang langmenu d-none d-md-flex align-items-center">
                {{{ output.navbar_language_menu }}}
            </div>

            {{! Edit-mode control (empty on pages without editing). }}
            <div class="nit-navbar-tools d-none d-md-flex align-items-center">
                <div class="nit-navbar-editswitch d-flex align-items-center">{{{ output.edit_switch }}}</div>
            </div>

            {{! Notifications / messaging (the bell). }}
            {{# output.navbar_plugin_output }}
                {{{ . }}}
            {{/output.navbar_plugin_output}}

            {{! User menu (avatar) — Dashboard / Profile / Grades / Log out / Switch role. }}
            {{#usermenu}}
                <div class="d-flex align-items-stretch usermenu-container" data-region="usermenu">
                    {{! The links set on Site pages → Navbar menus, else Moodle's menu. }}
                    {{{ output.nit_user_menu }}}
                </div>
            {{/usermenu}}

            {{! Visitor-only buttons (shown via body.notloggedin). }}
            <div class="nit-navbar-guest">
                <a class="nit-navbar-btn login" href="{{ config.wwwroot }}/login/index.php">{{#str}}bth_login, theme_nit{{/str}}</a>
                <a class="nit-navbar-btn signup" href="{{ config.wwwroot }}/local/academy/register.php">{{#str}}bth_signup, theme_nit{{/str}}</a>
            </div>
        </div>
    </div>
</nav>

{{! Search dialog — posts to Moodle's real course search. }}
<div class="nit-search-modal nit-brand-18" id="nit-search-modal" role="dialog" aria-modal="true" aria-labelledby="nit-search-title" aria-hidden="true">
    <div class="nit-search-backdrop" data-nit-search-close></div>
    <form class="nit-search-card" action="{{ config.wwwroot }}/course/search.php" method="get" role="search">
        <div class="nit-search-title" id="nit-search-title">{{#str}}bth_searchtitle, theme_nit{{/str}}</div>
        <div class="nit-search-group">
            <input type="text" name="search" id="nit-search-input" required placeholder=" " autocomplete="off">
            <label for="nit-search-input">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5A6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5S14 7.01 14 9.5S11.99 14 9.5 14"/></svg>
                <span>{{#str}}bth_searchlabel, theme_nit{{/str}}</span>
            </label>
            <span class="nit-search-bar"></span>
        </div>
        <button type="submit" class="nit-search-submit">{{#str}}bth_searchsubmit, theme_nit{{/str}}</button>
    </form>
</div>

<script>
(function(){
  // ---- scroll progress (inside the pill): slides in when scrolled, out at the top ----
  var track = document.getElementById('nit-navbar-track');
  var fill = document.getElementById('nit-navbar-fill');
  function onScroll(){
    var st = window.pageYOffset || document.documentElement.scrollTop || 0;
    var h = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    if(fill){ fill.style.width = (h > 0 ? (st / h) * 100 : 0) + '%'; }
    if(track){ track.classList.toggle('show', st > 4); }
  }
  window.addEventListener('scroll', onScroll, {passive:true});
  window.addEventListener('resize', onScroll);
  onScroll();

  // ---- search dialog ----
  var modal = document.getElementById('nit-search-modal');
  var input = document.getElementById('nit-search-input');
  function openSearch(){ if(!modal) return; modal.classList.add('open'); modal.setAttribute('aria-hidden','false');
    setTimeout(function(){ if(input){ input.focus(); } }, 50); }
  function closeSearch(){ if(!modal) return; modal.classList.remove('open'); modal.setAttribute('aria-hidden','true'); }
  document.querySelectorAll('[data-nit-search-open]').forEach(function(b){ b.addEventListener('click', openSearch); });
  document.querySelectorAll('[data-nit-search-close]').forEach(function(b){ b.addEventListener('click', closeSearch); });
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && modal && modal.classList.contains('open')){ closeSearch(); } });
})();
</script>

