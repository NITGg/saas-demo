{{!
    @template theme_boost/navbar

    NIT override of the Boost top navbar — rebuilt to the T1 "Academy app" design
    (docs/designs/T1 Academy App Screens): logo + wordmark, inline primary-nav
    links, a course search box, then the right cluster (language, edit-mode
    control, notifications, user menu). Every Moodle control is the real one:

      * Inline links come from Moodle's own primary navigation (mobileprimarynav);
        parents with children open a dropdown. On < lg they collapse into the
        standard mobile primary drawer (the toggler + primary-drawer-mobile).
      * Search posts to Moodle's real /course/search.php.
      * Edit-mode control is output.edit_switch (unchanged).
      * Notifications/messaging is output.navbar_plugin_output (unchanged).
      * User menu is core/user_menu (avatar + Dashboard/Profile/Log out …).
      * Language menu is output.navbar_language_menu (shows for logged-in users).
      * Owner "Upgrade" link is output.nit_account_link (renders '' otherwise).

    COLOURS follow the active homepage template: the bar reads the --t-* tokens
    (light on light templates, dark on t4) — see theme_nit_template_tokens_scss()
    and scss/components/_navbar_t1.scss. Re-diff the stock navbar on each Moodle
    upgrade (tracked in theme/nit/docs/override-budget.md).

    Context variables required for this template:
    * output - The core renderer for the page.
    * sitename - The name of the site.
    * config - wwwroot / homeurl.
    * langmenu - Language menu context (from the primary output).
    * usermenu - User menu context (from the primary output).
    * mobileprimarynav - Array of primary nav items ({text, url, isactive, haschildren, children}).
}}
<nav class="navbar fixed-top navbar-expand-lg nit-navbar" aria-label="{{#str}}sitemenubar, admin{{/str}}">
    <div class="container-fluid nit-navbar-inner">
        {{! Mobile: open Moodle's primary drawer (holds the nav on small screens). }}
        <button class="navbar-toggler aabtn d-lg-none px-1 my-1 border-0 nit-navbar-burger" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-primary">
            <span class="navbar-toggler-icon"></span>
            <span class="visually-hidden">{{#str}}sidepanel, core{{/str}}</span>
        </button>

        {{! Brand — compact logo (or a fallback mark) + the site name. }}
        <a href="{{{ config.homeurl }}}" data-nit-edit="logo" class="navbar-brand nit-navbar-brand d-flex align-items-center m-0 p-0 aabtn">
            {{# output.should_display_navbar_logo }}
                <img src="{{output.get_compact_logo_url}}" class="nit-navbar-logo" alt="{{sitename}}">
            {{/ output.should_display_navbar_logo }}
            {{^ output.should_display_navbar_logo }}
                <span class="nit-navbar-mark" aria-hidden="true"></span>
            {{/ output.should_display_navbar_logo }}
            <span class="nit-navbar-title">{{{ sitename }}}</span>
        </a>

        {{! Inline primary navigation (real Moodle nav), design-styled. }}
        <ul class="nit-navbar-links d-none d-lg-flex align-items-center m-0 p-0">
            {{#mobileprimarynav}}
                {{^haschildren}}
                    <li class="nit-navbar-linkitem">
                        <a class="nit-navbar-link{{#isactive}} active{{/isactive}}" href="{{{url}}}" {{#isactive}}aria-current="true"{{/isactive}}>{{{text}}}</a>
                    </li>
                {{/haschildren}}
                {{#haschildren}}
                    <li class="nit-navbar-linkitem dropdown">
                        <a class="nit-navbar-link dropdown-toggle{{#isactive}} active{{/isactive}}" href="{{{url}}}" role="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">{{{text}}}</a>
                        <div class="dropdown-menu nit-navbar-dropdown">
                            {{#children}}
                                {{^divider}}
                                    <a class="dropdown-item{{#isactive}} active{{/isactive}}" href="{{{url}}}" {{#isactive}}aria-current="true"{{/isactive}}>{{{text}}}</a>
                                {{/divider}}
                            {{/children}}
                        </div>
                    </li>
                {{/haschildren}}
            {{/mobileprimarynav}}
        </ul>

        <div id="usernavigation" class="nit-navbar-right navbar-nav ms-auto h-100 align-items-center">
            {{! Course search — posts to Moodle's real course search. }}
            <form class="nit-navbar-search d-none d-md-flex align-items-center" action="{{ config.wwwroot }}/course/search.php" method="get" role="search">
                <i class="icon fa fa-search fa-fw m-0" aria-hidden="true"></i>
                <input type="text" name="search" class="nit-navbar-search-input" placeholder="{{#str}}searchcourses{{/str}}" aria-label="{{#str}}searchcourses{{/str}}" autocomplete="off">
            </form>

            {{! Language menu (shows for logged-in users too). }}
            <div class="nit-navbar-lang langmenu d-none d-md-flex align-items-center">
                {{{ output.navbar_language_menu }}}
            </div>

            {{! Edit-mode control — the design's "Edit page" affordance. The wrapper
                is :empty on pages without editing, so CSS hides it. }}
            <div class="nit-navbar-tools d-none d-md-flex align-items-center">
                <div class="nit-navbar-editswitch d-flex align-items-center">{{{ output.edit_switch }}}</div>
            </div>

            {{! Notifications / messaging (the bell) — kept as-is. }}
            {{# output.navbar_plugin_output }}
                {{{ . }}}
            {{/output.navbar_plugin_output}}

            {{! Owner "Upgrade" link → control-plane account page ('' for non-owners). }}
            {{{ output.nit_account_link }}}

            {{! User menu (avatar) — Dashboard / Profile / Grades / Log out / Switch role. }}
            {{#usermenu}}
                <div class="d-flex align-items-stretch usermenu-container ms-1" data-region="usermenu">
                    {{> core/user_menu }}
                </div>
            {{/usermenu}}
        </div>
    </div>
</nav>

{{> theme_boost/primary-drawer-mobile }}
