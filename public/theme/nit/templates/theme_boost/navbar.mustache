{{!
    @template theme_boost/navbar

    NIT override of the Boost top navbar — rebuilt to the T1 "Academy app" design
    (docs/designs/T1 Academy App Screens): logo + wordmark, inline primary-nav
    links, a course search box, then the right cluster (language, edit-mode
    control, notifications, user menu). Every Moodle control is the real one:

      * Inline links come from Moodle's own primary navigation (mobileprimarynav);
        parents with children open a dropdown. On < lg they collapse into the
        standard mobile primary drawer (the toggler + primary-drawer-mobile).
      * Search posts to Moodle's real /course/search.php.
      * Edit-mode control is output.edit_switch (unchanged).
      * Notifications/messaging is output.navbar_plugin_output (unchanged).
      * User menu is core/user_menu (avatar + Dashboard/Profile/Log out …).
      * Language menu is output.navbar_language_menu (shows for logged-in users).
      * Owner "Upgrade" link is output.nit_account_link (renders '' otherwise).

    COLOURS follow the active homepage template: the bar reads the --t-* tokens
    (light on light templates, dark on t4) — see theme_nit_template_tokens_scss()
    and scss/components/_navbar_t1.scss. Re-diff the stock navbar on each Moodle
    upgrade (tracked in theme/nit/docs/override-budget.md).

    Context variables required for this template:
    * output - The core renderer for the page.
    * sitename - The name of the site.
    * config - wwwroot / homeurl.
    * langmenu - Language menu context (from the primary output).
    * usermenu - User menu context (from the primary output).
    * mobileprimarynav - Array of primary nav items ({text, url, isactive, haschildren, children}).
}}
<div class="nit-scrollbar" id="nit-scrollbar" aria-hidden="true"></div>
<style id="nit-bassthalk-navbar">
  @import url('https://fonts.googleapis.com/css2?family=Almarai:wght@400;700;800&family=Tajawal:wght@400;500;700&display=swap');
  /* ===== Bassthalk-style floating pill navbar (site-wide, RTL) ===== */
  .nit-navbar.nit-navbar{ background:transparent!important; box-shadow:none!important; border:0!important;
    padding:16px clamp(12px,2.5vw,32px) 0!important; direction:rtl; font-family:'Tajawal','Almarai',sans-serif; }
  .nit-navbar .nit-navbar-inner{ background:#0080FF!important; border-radius:9999px; max-width:none; width:100%;
    min-height:80px; padding-inline:clamp(16px,2vw,28px); gap:clamp(10px,1.6vw,20px);
    box-shadow:0 10px 28px rgba(0,128,255,.22); }
  /* brand (right) */
  .nit-navbar .nit-navbar-logo{ height:46px!important; width:auto!important; }
  .nit-navbar .nit-navbar-title{ display:none!important; }
  .nit-navbar .nit-navbar-mark{ background:#fff; }
  /* inline links -> white */
  .nit-navbar .nit-navbar-link{ color:#fff!important; font-weight:500; }
  .nit-navbar .nit-navbar-link.active, .nit-navbar .nit-navbar-link:hover{ color:#eafff4!important; }
  /* search pill */
  .nit-navbar .nit-navbar-search{ background:rgba(255,255,255,.16); border:1px solid rgba(255,255,255,.28);
    border-radius:9999px; padding:8px 16px; gap:8px; color:#fff; }
  .nit-navbar .nit-navbar-search .icon{ color:#fff; }
  .nit-navbar .nit-navbar-search-input{ color:#fff; background:transparent; border:0; font-family:'Tajawal'; font-size:14px; min-width:150px; }
  .nit-navbar .nit-navbar-search-input::placeholder{ color:rgba(255,255,255,.85); }
  /* right cluster */
  .nit-navbar .nit-navbar-right{ gap:clamp(8px,1.2vw,14px); }
  /* theme (dark mode) toggle */
  .nit-navbar-themebtn{ width:38px; height:38px; border-radius:50%; background:rgba(255,255,255,.18);
    border:0; color:#fff; display:inline-flex; align-items:center; justify-content:center; cursor:pointer; flex:none; }
  .nit-navbar-themebtn:hover{ background:rgba(255,255,255,.3); }
  /* visitor buttons */
  .nit-navbar-guest{ display:none; align-items:center; gap:10px; }
  body.notloggedin .nit-navbar-guest{ display:inline-flex; }
  body.notloggedin .nit-navbar .usermenu-container,
  body.notloggedin .nit-navbar .nit-navbar-editswitch,
  body.notloggedin .nit-navbar .nit-navbar-lang{ display:none!important; }
  .nit-navbar-btn{ height:40px; border-radius:7px; padding:8px 18px; font-family:'Tajawal'; font-size:14px; font-weight:700;
    display:inline-flex; align-items:center; justify-content:center; text-decoration:none!important; border:2px solid transparent; white-space:nowrap; }
  .nit-navbar-btn.login{ background:#0E335D; border-color:#0E335D; color:#fff; }
  .nit-navbar-btn.login:hover{ background:#0b2a4d; }
  .nit-navbar-btn.signup{ background:#4BF7A1; border-color:#4BF7A1; color:#0E335D; }
  .nit-navbar-btn.signup:hover{ filter:brightness(.96); }
  /* user menu (logged in) -> white text on blue */
  .nit-navbar .usermenu-container .usertext, .nit-navbar .usermenu-container a{ color:#fff!important; }
  /* scroll progress bar */
  .nit-scrollbar{ position:fixed!important; top:0!important; inset-inline-start:0; height:4px; width:0; background:#0E335D;
    z-index:1051; opacity:0!important; transition:opacity .35s ease, width .1s linear; display:block!important; pointer-events:none; }
  .nit-scrollbar.show{ opacity:1!important; }
  @media (max-width:991px){ .nit-navbar .nit-navbar-inner{ border-radius:20px; min-height:64px; } .nit-navbar .nit-navbar-logo{ height:38px!important; } }
</style>
<nav class="navbar fixed-top navbar-expand-lg nit-navbar" aria-label="{{#str}}sitemenubar, admin{{/str}}">
    <div class="container-fluid nit-navbar-inner">
        {{! Mobile: open Moodle's primary drawer (holds the nav on small screens). }}
        <button class="navbar-toggler aabtn d-lg-none px-1 my-1 border-0 nit-navbar-burger" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-primary">
            <span class="navbar-toggler-icon"></span>
            <span class="visually-hidden">{{#str}}sidepanel, core{{/str}}</span>
        </button>

        {{! Brand — compact logo (or a fallback mark) + the site name. }}
        <a href="{{{ config.homeurl }}}" data-nit-edit="logo" class="navbar-brand nit-navbar-brand d-flex align-items-center m-0 p-0 aabtn">
            {{# output.should_display_navbar_logo }}
                <img src="{{output.get_compact_logo_url}}" class="nit-navbar-logo" alt="{{sitename}}">
            {{/ output.should_display_navbar_logo }}
            {{^ output.should_display_navbar_logo }}
                <span class="nit-navbar-mark" aria-hidden="true"></span>
            {{/ output.should_display_navbar_logo }}
            <span class="nit-navbar-title">{{{ sitename }}}</span>
        </a>

        {{! Inline primary navigation (real Moodle nav), design-styled. }}
        <ul class="nit-navbar-links d-none d-lg-flex align-items-center m-0 p-0">
            {{#mobileprimarynav}}
                {{^haschildren}}
                    <li class="nit-navbar-linkitem">
                        <a class="nit-navbar-link{{#isactive}} active{{/isactive}}" href="{{{url}}}" {{#isactive}}aria-current="true"{{/isactive}}>{{{text}}}</a>
                    </li>
                {{/haschildren}}
                {{#haschildren}}
                    <li class="nit-navbar-linkitem dropdown">
                        <a class="nit-navbar-link dropdown-toggle{{#isactive}} active{{/isactive}}" href="{{{url}}}" role="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">{{{text}}}</a>
                        <div class="dropdown-menu nit-navbar-dropdown">
                            {{#children}}
                                {{^divider}}
                                    <a class="dropdown-item{{#isactive}} active{{/isactive}}" href="{{{url}}}" {{#isactive}}aria-current="true"{{/isactive}}>{{{text}}}</a>
                                {{/divider}}
                            {{/children}}
                        </div>
                    </li>
                {{/haschildren}}
            {{/mobileprimarynav}}
        </ul>

        <div id="usernavigation" class="nit-navbar-right navbar-nav ms-auto h-100 align-items-center">
            {{! Course search — posts to Moodle's real course search. }}
            <form class="nit-navbar-search d-none d-md-flex align-items-center" action="{{ config.wwwroot }}/course/search.php" method="get" role="search">
                <i class="icon fa fa-search fa-fw m-0" aria-hidden="true"></i>
                <input type="text" name="search" class="nit-navbar-search-input" placeholder="ابحث في الموقع" aria-label="{{#str}}searchcourses{{/str}}" autocomplete="off">
            </form>

            {{! Dark-mode toggle (Bassthalk sun). }}
            <button type="button" class="nit-navbar-themebtn" id="nit-theme-toggle" aria-label="Toggle dark mode" title="الوضع الليلي">
                <svg class="nit-ico-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4 12H2M22 12h-2M5 5l1.5 1.5M17.5 17.5 19 19M19 5l-1.5 1.5M6.5 17.5 5 19"/></svg>
            </button>

            {{! Language menu (shows for logged-in users too). }}
            <div class="nit-navbar-lang langmenu d-none d-md-flex align-items-center">
                {{{ output.navbar_language_menu }}}
            </div>

            {{! Edit-mode control — the design's "Edit page" affordance. The wrapper
                is :empty on pages without editing, so CSS hides it. }}
            <div class="nit-navbar-tools d-none d-md-flex align-items-center">
                <div class="nit-navbar-editswitch d-flex align-items-center">{{{ output.edit_switch }}}</div>
            </div>

            {{! Notifications / messaging (the bell) — kept as-is. }}
            {{# output.navbar_plugin_output }}
                {{{ . }}}
            {{/output.navbar_plugin_output}}

            {{! Owner "Upgrade" link → control-plane account page ('' for non-owners). }}
            {{{ output.nit_account_link }}}

            {{! User menu (avatar) — Dashboard / Profile / Grades / Log out / Switch role. }}
            {{#usermenu}}
                <div class="d-flex align-items-stretch usermenu-container ms-1" data-region="usermenu">
                    {{> core/user_menu }}
                </div>
            {{/usermenu}}

            {{! Visitor-only buttons (hidden for logged-in users via body.notloggedin). }}
            <div class="nit-navbar-guest">
                <a class="nit-navbar-btn login" href="{{ config.wwwroot }}/login/index.php">تسجيل الدخول</a>
                <a class="nit-navbar-btn signup" href="{{ config.wwwroot }}/local/academy/register.php">حساب جديد</a>
            </div>
        </div>
    </div>
</nav>

<script>
(function(){
  // ---- scroll progress bar: appears on scroll, hides at top ----
  var bar = document.getElementById('nit-scrollbar');
  function onScroll(){
    var st = window.pageYOffset || document.documentElement.scrollTop;
    var h = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    var pct = h > 0 ? (st / h) * 100 : 0;
    if(bar){ bar.style.width = pct + '%'; bar.classList.toggle('show', st > 8); }
  }
  window.addEventListener('scroll', onScroll, {passive:true});
  onScroll();
  // ---- dark-mode toggle (basic: toggles a class + remembers choice) ----
  var tbtn = document.getElementById('nit-theme-toggle');
  try{ if(localStorage.getItem('nit-dark')==='1'){ document.documentElement.classList.add('nit-dark'); } }catch(e){}
  if(tbtn){ tbtn.addEventListener('click', function(){
    var on = document.documentElement.classList.toggle('nit-dark');
    try{ localStorage.setItem('nit-dark', on?'1':'0'); }catch(e){}
  }); }
})();
</script>

{{> theme_boost/primary-drawer-mobile }}
