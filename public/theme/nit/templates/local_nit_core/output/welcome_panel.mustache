{{!
    @template local_nit_core/output/welcome_panel

    NIT theme override of the SDK welcome panel. Same data contract; styled with
    NIT design tokens (M3). Demonstrates the template-override framework.

    Context variables required for this template:
    * greeting - string
    * message - string
    * ctas - array of { label, url }

    Example context (json):
    {
        "greeting": "Welcome back, Sam!",
        "message": "Here is your learning at a glance.",
        "ctas": [ { "label": "Go to my courses", "url": "/my/courses.php" } ]
    }
}}
<div class="nit-welcome mb-3" role="status">
    <div class="d-flex flex-wrap align-items-center gap-3 p-4"
         style="background: var(--nit-surface); border: 1px solid var(--nit-line); border-left: 4px solid var(--nit-primary); border-radius: var(--nit-radius-lg); box-shadow: var(--nit-shadow-2);">
        <div class="flex-grow-1">
            <div class="h5 mb-1">{{greeting}}</div>
            <div class="text-muted mb-0">{{message}}</div>
        </div>
        {{#ctas}}
            <a class="btn btn-primary" href="{{url}}">{{label}}</a>
        {{/ctas}}
    </div>
</div>
