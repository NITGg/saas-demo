{{!
    @template mod_flashcard/finished

    Shown by js/module.js (#finished) once every card of a free play round is removed.

    Example context (json):
    {}
}}
<div id="finished" style="display: none;" class="nit-fc-card nit-fc-finished">
    <span class="nit-fc-finished__icon" aria-hidden="true">&#10003;</span>
    <div class="nit-fc-content">{{#str}}freedone, mod_flashcard{{/str}}</div>
</div>
