<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/jitsi/db" VERSION="20260621" COMMENT="XMLDB file for mod_jitsi"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="jitsi" COMMENT="Stores the Jitsi session activity instances.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="roompassword" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Optional Jitsi room password set by the teacher."/>
        <FIELD NAME="lobby_enabled" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="1 = waiting room: the Jitsi lobby, students knock and the teacher admits them in the meeting; hosts never wait."/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="course" UNIQUE="false" FIELDS="course"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="jitsi_presence" COMMENT="Every stretch someone spent in a room's call (the room's attendance log)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="jitsiid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="host" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="1 = a host of the room (teacher, manager, admin)"/>
        <FIELD NAME="joined_at" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="last_seen" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="last heartbeat from the client; a stretch silent for 3 min is closed here"/>
        <FIELD NAME="left_at" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="null = still in the call"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="jitsiid_fk" TYPE="foreign" FIELDS="jitsiid" REFTABLE="jitsi" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="jitsi_user_idx" UNIQUE="false" FIELDS="jitsiid, userid"/>
        <INDEX NAME="jitsi_joined_idx" UNIQUE="false" FIELDS="jitsiid, joined_at"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
