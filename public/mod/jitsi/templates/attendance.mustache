{{!
    @template mod_jitsi/attendance

    A room's attendance log for one day (attendance.php): four numbers, then everyone on
    the day's timeline, hosts first. Each person row is local_academysessions/monitor_person
    (the same bars as the live monitoring wall).

    Example context (json):
    {
        "tiles": [{"label": "People", "value": 3}],
        "axis": {"from": "9:00 AM", "to": "10:10 AM", "hasnow": false, "now": 0, "planstart": 0, "plansize": 0},
        "hosts": [], "hashosts": false, "students": [], "studentcount": 0
    }
}}
<div class="nitmon nitmon-detail">
    <dl class="nitmon-tiles">
        {{#tiles}}
        <div class="nitmon-tile"><dt>{{label}}</dt><dd>{{value}}</dd></div>
        {{/tiles}}
    </dl>
    <section class="nitmon-timeline" aria-label="{{#str}} attendancelog, jitsi {{/str}}">
        {{#axis}}
        <div class="nitmon-axis" aria-hidden="true">
            <span class="nitmon-axis-spacer"></span>
            <div class="nitmon-axis-scale">
                <bdi dir="ltr" class="nitmon-axis-from">{{from}}</bdi>
                <bdi dir="ltr" class="nitmon-axis-to">{{to}}</bdi>
            </div>
            <span class="nitmon-axis-spacer nitmon-axis-spacer-end"></span>
        </div>
        {{/axis}}
        {{#hashosts}}
        <h4 class="nitmon-group">{{#str}} log_hosts, jitsi {{/str}}</h4>
        <ul class="nitmon-people">{{#hosts}}{{> local_academysessions/monitor_person }}{{/hosts}}</ul>
        {{/hashosts}}
        <h4 class="nitmon-group">{{#str}} log_students, jitsi {{/str}} <span class="nitmon-count">{{studentcount}}</span></h4>
        <ul class="nitmon-people">{{#students}}{{> local_academysessions/monitor_person }}{{/students}}</ul>
    </section>
</div>
